            string prompt =
                "הנה מייל שמבקש קבצים, ומידע רקע מהמדריכים/הידע הנלמד של המערכת (יכול להכיל נתיבי תיקיות אמיתיים שנלמדו בעבר):\n\n" +
                "=== ידע רקע ===\n" + kb.ToString() + "=== סוף ידע רקע ===\n\n" +

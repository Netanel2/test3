        static bool IsAllowed(string path)
        {
            if (AllowedDirs == null || AllowedDirs.Length == 0) return true;
            string full; try { full = Path.GetFullPath(path).TrimEnd('\\') + "\\"; } catch { return false; }
            foreach (var d in AllowedDirs) { string bd; try { bd = Path.GetFullPath(d).TrimEnd('\\') + "\\"; } catch { continue; } if (full.StartsWith(bd, StringComparison.OrdinalIgnoreCase)) return true; }
            return false;
        }
        static string Human(long b) { string[] u = { "B", "KB", "MB", "GB", "TB" }; double s = b; int i = 0; while (s >= 1024 && i < u.Length - 1) { s /= 1024; i++; } return s.ToString("0.##") + " " + u[i]; }
        static object FsSearchByName(string query, string root)
        {
            if (string.IsNullOrWhiteSpace(query)) return new { ok = false, error = "חסרה מילת חיפוש" };
            var roots = new List<string>();
            if (!string.IsNullOrWhiteSpace(root))
            {
                if (!IsAllowed(root)) return new { ok = false, error = "התיקייה מחוץ לתיקיות המותרות." };
                if (!Directory.Exists(root)) return new { ok = false, error = "התיקייה לא קיימת: " + root };
                roots.Add(root);
            }
            else if (AllowedDirs != null && AllowedDirs.Length > 0) { roots.AddRange(AllowedDirs.Where(Directory.Exists)); }
            else return new { ok = false, error = "צריך לציין תיקיית שורש לחיפוש (אין הגבלת ALLOWED_DIRS מוגדרת שממנה אפשר לחפש אוטומטית)." };

            var matches = new List<string>();
            foreach (var r in roots)
            {
                try
                {
                    foreach (var f in Directory.EnumerateFiles(r, "*", SearchOption.AllDirectories))
                    {
                        if (Path.GetFileName(f).IndexOf(query, StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            matches.Add(f);
                            if (matches.Count >= 50) break;
                        }
                    }
                }
                catch (Exception ex) { Console.WriteLine("⚠️ שגיאה בחיפוש ב-" + r + ": " + ex.Message); }
                if (matches.Count >= 50) break;
            }
            return new { ok = true, query = query, count = matches.Count, matches = matches };
        }

        static object FsAnalyze(string path, bool recursive, string dateHint = "")
        {
            if (string.IsNullOrWhiteSpace(path)) return new { ok = false, error = "נתיב ריק" };
            path = ResolveSourceWithDateHint(path, dateHint);
            if (!IsAllowed(path)) return new { ok = false, error = "מחוץ לתיקיות המותרות." };
            if (!Directory.Exists(path)) return new { ok = false, error = "התיקייה לא קיימת: " + path };
            var files = Directory.GetFiles(path, "*", recursive ? SearchOption.AllDirectories : SearchOption.TopDirectoryOnly);
            if (files.Length == 0 && !recursive && Directory.GetDirectories(path).Length > 0)
                files = Directory.GetFiles(path, "*", SearchOption.AllDirectories); // אין קבצים ישירות אבל יש תת-תיקיות — נספור כולל אותן
            long total = 0; var byExt = new Dictionary<string, long[]>();
            foreach (var f in files) { long len = 0; try { len = new FileInfo(f).Length; } catch { } total += len; string ext = Path.GetExtension(f).ToLowerInvariant(); if (ext == "") ext = "(ללא)"; if (!byExt.ContainsKey(ext)) byExt[ext] = new long[2]; byExt[ext][0]++; byExt[ext][1] += len; }
            var types = byExt.OrderByDescending(k => k.Value[1]).Select(k => new { ext = k.Key, count = k.Value[0], size = Human(k.Value[1]) }).ToList();
            return new { ok = true, total = files.Length, totalSize = Human(total), types = types, path = path };
        }
        static string NormalizeMaybeUncPath(string path)
        {
            if (string.IsNullOrWhiteSpace(path)) return path;
            // תיקון תקלה נפוצה: ה-AI לפעמים "בולע" לוכסן הפוכה אחת מנתיב רשת (UNC) בגלל שגיאת escaping ב-JSON,
            // והופך \\server\share ל-\server\share. אם הנתיב כמו שהוא לא קיים, וזה נראה בדיוק כמו התקלה הזו — ננסה לתקן.
            if (path.Length > 1 && path[0] == '\\' && path[1] != '\\' && !Directory.Exists(path))
            {
                string fixedPath = "\\" + path;
                if (Directory.Exists(fixedPath))
                {
                    Console.WriteLine("[אבחון] תוקן נתיב רשת חסר לוכסן: '" + path + "' -> '" + fixedPath + "'");
                    return fixedPath;
                }
            }
            return path;
        }

        static string ResolveSourceWithDateHint(string source, string dateHint)
        {
            source = NormalizeMaybeUncPath(source);
            Console.WriteLine("[אבחון] ResolveSourceWithDateHint: source='" + source + "' dateHint='" + dateHint + "'");
            if (string.IsNullOrWhiteSpace(dateHint)) return source;
            string digits = new string(dateHint.Where(char.IsDigit).ToArray());
            Console.WriteLine("[אבחון] ספרות שחולצו מה-dateHint: '" + digits + "'");
            if (digits.Length == 0) return source;
            if (Directory.Exists(source))
            {
                try
                {
                    Console.WriteLine("[אבחון] תת-תיקיות שנמצאו ב-" + source + ":");
                    foreach (var sd in Directory.GetDirectories(source))
                    {
                        DateTime lw = DateTime.MinValue; try { lw = Directory.GetLastWriteTime(sd); } catch { }
                        Console.WriteLine("[אבחון]   - " + Path.GetFileName(sd) + " | תאריך שינוי אחרון: " + lw.ToString("dd/MM/yyyy"));
                    }
                }
                catch (Exception ex) { Console.WriteLine("[אבחון] שגיאה בסריקת תת-תיקיות: " + ex.Message); }
                // אולי המקור עצמו כבר תואם (למשל שמו מכיל את התאריך) — נבדוק גם אם יש תת-תיקייה מתאימה בתוכו
                var resolved = FindFolderByDate(source, digits);
                Console.WriteLine("[אבחון] תוצאת FindFolderByDate: " + (resolved ?? "(לא נמצאה התאמה יחידה)"));
                if (resolved != null) return resolved;
                return source; // המקור קיים כמו שהוא — נשתמש בו כפי שהוא
            }
            Console.WriteLine("[אבחון] המקור '" + source + "' לא נגיש/לא קיים כפי שהוא.");
            // המקור שניתן לא קיים כתיקייה בפני עצמה — ננסה לחפש תת-תיקייה מתאימה בתיקיית האב שלו
            string parent = Path.GetDirectoryName(source);
            if (!string.IsNullOrWhiteSpace(parent) && Directory.Exists(parent))
            {
                var resolved = FindFolderByDate(parent, digits);
                if (resolved != null) return resolved;
            }
            return source;
        }

        static List<List<string>> ParseRows(Dictionary<string, object> data)
        {
            var result = new List<List<string>>();
            try
            {
                if (data != null && data.ContainsKey("rows") && data["rows"] is object[] rowsArr)
                {
                    foreach (var r in rowsArr)
                    {
                        var rowList = new List<string>();
                        if (r is object[] cellsArr) foreach (var c in cellsArr) rowList.Add(c == null ? "" : c.ToString());
                        result.Add(rowList);
                    }
                }
            }
            catch { }
            return result;
        }


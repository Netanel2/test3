        static DateTime ParseSqlAgentDateTime(int runDate, int runTime)
        {
            try
            {
                string ds = runDate.ToString().PadLeft(8, '0');
                string ts = runTime.ToString().PadLeft(6, '0');
                int y = int.Parse(ds.Substring(0, 4)), mo = int.Parse(ds.Substring(4, 2)), da = int.Parse(ds.Substring(6, 2));
                int h = int.Parse(ts.Substring(0, 2)), mi = int.Parse(ts.Substring(2, 2)), se = int.Parse(ts.Substring(4, 2));
                return new DateTime(y, mo, da, h, mi, se);
            }
            catch { return DateTime.MinValue; }
        }

        static void MonitorJobAndReport(string jobName, string notifyEmail, DateTime startedAfter)
        {
            string cs = SqlConnStr();
            if (cs == null) return;
            DateTime deadline = DateTime.Now.AddMinutes(30);
            while (DateTime.Now < deadline)
            {
                System.Threading.Thread.Sleep(15000);
                try
                {
                    using (var conn = new SqlConnection(cs))
                    {
                        conn.Open();
                        string sql = @"SELECT TOP 1 h.run_status, h.run_date, h.run_time, h.message
                                       FROM msdb.dbo.sysjobs j
                                       JOIN msdb.dbo.sysjobhistory h ON j.job_id = h.job_id
                                       WHERE j.name = @n AND h.step_id = 0
                                       ORDER BY h.instance_id DESC";
                        using (var cmd = new SqlCommand(sql, conn))
                        {
                            cmd.Parameters.AddWithValue("@n", jobName);
                            using (var r = cmd.ExecuteReader())
                            {
                                if (r.Read())
                                {
                                    int rd = r["run_date"] is int ? (int)r["run_date"] : 0;
                                    int rt = r["run_time"] is int ? (int)r["run_time"] : 0;
                                    DateTime runAt = ParseSqlAgentDateTime(rd, rt);
                                    if (runAt >= startedAfter.AddSeconds(-5))
                                    {
                                        int status = r["run_status"] is int ? (int)r["run_status"] : -1;
                                        string msg = r["message"] as string ?? "";
                                        string statusText = status == 1 ? "הסתיים בהצלחה ✅" : (status == 0 ? "נכשל ❌" : "סטטוס לא ידוע (" + status + ")");
                                        SendAutoMail(notifyEmail, "עדכון: JOB '" + jobName + "' " + statusText, "תוצאת ריצה: " + statusText + "\n\nפירוט: " + msg);
                                        Console.WriteLine("📬 נשלח עדכון סטטוס עבור JOB " + jobName + ": " + statusText);
                                        return;
                                    }
                                }
                            }
                        }
                    }
                }
                catch (Exception ex) { Console.WriteLine("⚠️ שגיאה במעקב אחרי JOB: " + ex.Message); }
            }
            Console.WriteLine("⏱️ הזמן הקצוב למעקב אחרי JOB " + jobName + " הסתיים בלי תוצאה סופית.");
        }


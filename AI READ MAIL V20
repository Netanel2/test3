                        { List<string> srcs; int cnt; lock (indexLock) { srcs = index.Select(c => c.Source).Distinct().ToList(); cnt = index.Count; } WriteJson(response, new { sources = srcs, chunks = cnt }); }
                        else { response.ContentType = "text/html; charset=utf-8"; byte[] hb = Encoding.UTF8.GetBytes(HTML_PAGE); await response.OutputStream.WriteAsync(hb, 0, hb.Length); response.Close(); }
                    }
                    catch (Exception ex) { Console.WriteLine("⚠️ " + ex.Message); }
                }
            });
            Console.ReadLine();
        }

        static async Task<Dictionary<string, object>> ReadJson(HttpListenerRequest request)
        { string b; using (var r = new StreamReader(request.InputStream, Encoding.UTF8)) b = await r.ReadToEndAsync(); return js.DeserializeObject(b) as Dictionary<string, object>; }
        static string Str(Dictionary<string, object> d, string k) { return (d != null && d.ContainsKey(k) && d[k] != null) ? d[k].ToString() : null; }

        static string RepairLooseJson(string s)
        {
            if (string.IsNullOrWhiteSpace(s)) return s;
            // מוסיף מרכאות לשמות שדות שלא במרכאות: {kind:  או  ,query:
            s = Regex.Replace(s, @"([\{,]\s*)([A-Za-z_][A-Za-z0-9_]*)\s*:", "$1\"$2\":");
            // מוסיף מרכאות לערכים מילוליים "חשופים" (לא true/false/null/מספר), לפני פסיק או סוגר
            s = Regex.Replace(s, @":\s*(?!"")(?!true\b)(?!false\b)(?!null\b)([A-Za-z_][A-Za-z0-9_.\-]*)\s*(?=[,}])", ": \"$1\"");
            return s;
        }


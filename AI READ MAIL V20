//  SSIS Script Task — חילוץ ת"ז לפי קובץ בקשות
//  תיקייה: C:\Users\netanelma\Desktop\extractid
//
//  פורמט קובץ הבקשות (NUMBERLINEANDID.txt): מספר שורה, ואז ת"ז בשורה נפרדת:
//     8
//     022556492
//     15
//     029472289
//  (הת"ז אופציונלית — אפשר לכתוב רק מספרי שורות. מספר בן 9 ספרות מזוהה כת"ז צפויה.)
//
//  מבנה שזוהה בקובץ המקור:  תווים 16-24 = ת"ז ,  תווים 35-54 = שם משפחה
// ============================================================

public void Main()
{
    // ---------- הגדרות ----------
    string Folder       = @"C:\Users\netanelma\Desktop\extractid";
    string SourcePath   = System.IO.Path.Combine(Folder, "BIGFILE.txt");          // <-- שנה לשם הקובץ הגדול
    string RequestsPath = System.IO.Path.Combine(Folder, "NUMBERLINEANDID.txt");
    string OutputPath   = System.IO.Path.Combine(Folder, "output.csv");

    int TzStart   = 16, TzLen   = 9;   // מיקום ת"ז (1-based)
    int NameStart = 35, NameLen = 20;  // מיקום שם
    // ----------------------------

    // 1) קריאת הבקשות. כלל: מספר בן 9 ספרות = ת"ז צפויה לשורה הקודמת; אחרת = מספר שורה חדש.
    var order  = new System.Collections.Generic.List<int>();               // סדר הופעה
    var wanted = new System.Collections.Generic.Dictionary<int, string>(); // שורה -> ת"ז צפויה
    int last = -1;

    foreach (var raw in System.IO.File.ReadAllLines(RequestsPath))
    {
        if (string.IsNullOrWhiteSpace(raw)) continue;
        var m = System.Text.RegularExpressions.Regex.Match(raw, @"\d+");
        if (!m.Success) continue;
        string tok = m.Value;

        if (tok.Length == 9)                      // ת"ז צפויה לשורה האחרונה
        {
            if (last != -1) wanted[last] = tok;
        }
        else                                      // מספר שורה חדש
        {
            int ln = int.Parse(tok);
            if (!wanted.ContainsKey(ln)) { wanted[ln] = ""; order.Add(ln); }
            last = ln;
        }
    }

    // 2) מעבר יחיד על הקובץ הכבד בסטרימינג
    int written = 0;
    using (var reader = new System.IO.StreamReader(SourcePath, System.Text.Encoding.UTF8))
    using (var writer = new System.IO.StreamWriter(OutputPath, false, new System.Text.UTF8Encoding(true)))
    {
        writer.WriteLine("מספר שורה,תעודת זהות,תקינות,ת\"ז צפויה,תואם,שם");

        string line;
        int lineNo = 0;
        while ((line = reader.ReadLine()) != null)
        {
            lineNo++;
            if (!wanted.ContainsKey(lineNo)) continue;

            string tz       = Slice(line, TzStart, TzLen);
            string name     = Slice(line, NameStart, NameLen).TrimEnd();
            string valid    = IsValidIsraeliId(tz) ? "תקין" : "לא תקין";
            string expected = wanted[lineNo];
            string match    = (expected == "") ? "" : (expected == tz ? "כן" : "לא");

            writer.WriteLine(lineNo + ",\"" + tz + "\"," + valid + ",\"" + expected + "\"," + match
                             + ",\"" + name.Replace("\"", "\"\"") + "\"");
            written++;

            if (written == wanted.Count) break; // מצאנו הכל — עצור
        }
    }

    System.Windows.Forms.MessageBox.Show("הסתיים. נכתבו " + written + " מתוך " + wanted.Count
                                         + " בקשות אל:\n" + OutputPath);
    Dts.TaskResult = (int)ScriptResults.Success;
}

string Slice(string s, int start1Based, int len)
{
    int start = start1Based - 1;
    if (s == null || start >= s.Length) return "";
    if (start + len > s.Length) len = s.Length - start;
    return s.Substring(start, len);
}

bool IsValidIsraeliId(string id)
{
    if (string.IsNullOrEmpty(id) || id.Length != 9) return false;
    int total = 0;
    for (int i = 0; i < 9; i++)
    {
        if (!char.IsDigit(id[i])) return false;
        int inc = (id[i] - '0') * ((i % 2 == 0) ? 1 : 2);
        total += (inc > 9) ? inc - 9 : inc;
    }
    return total % 10 == 0;
}

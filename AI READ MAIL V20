        static object ListFailedJobs(string dateFilter)
        {
            string cs = SqlConnStr();
            if (cs == null) return new { ok = false, error = "לא הוגדר SQL_SERVER בקובץ ה-.env." };
            DateTime day = dateFilter == "yesterday" ? DateTime.Today.AddDays(-1) : DateTime.Today;
            string dayStr = day.ToString("yyyyMMdd");
            var jobs = new List<object>();
            try
            {
                using (var conn = new SqlConnection(cs))
                {
                    conn.Open();
                    string sql = @"SELECT j.name AS JobName, h.run_date, h.run_time, h.message
                                   FROM msdb.dbo.sysjobs j
                                   JOIN msdb.dbo.sysjobhistory h ON j.job_id = h.job_id
                                   WHERE h.step_id = 0 AND h.run_status = 0 AND h.run_date = @d
                                   ORDER BY h.run_date DESC, h.run_time DESC";
                    using (var cmd = new SqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@d", dayStr);
                        using (var r = cmd.ExecuteReader())
                        {
                            while (r.Read())
                            {
                                string name = r["JobName"] as string ?? "";
                                int rd = r["run_date"] is int ? (int)r["run_date"] : 0;
                                int rt = r["run_time"] is int ? (int)r["run_time"] : 0;
                                string msg = r["message"] as string ?? "";
                                if (msg.Length > 300) msg = msg.Substring(0, 300) + "...";
                                string timeStr = rt.ToString("D6");
                                string dateFmt = rd.ToString().Length == 8 ? (rd.ToString().Substring(6, 2) + "/" + rd.ToString().Substring(4, 2) + "/" + rd.ToString().Substring(0, 4)) : rd.ToString();
                                jobs.Add(new { name = name, date = dateFmt, time = timeStr.Substring(0, 2) + ":" + timeStr.Substring(2, 2) + ":" + timeStr.Substring(4, 2), message = msg });
                            }
                        }
                    }
                }
                Console.WriteLine("🗄️ נמצאו " + jobs.Count + " JOBs שנכשלו.");
                return new { ok = true, jobs = jobs };
            }
            catch (Exception ex) { return new { ok = false, error = "שגיאת SQL: " + ex.Message }; }
        }

        static bool TryRunSqlJob(string jobName, out string error)
        {
            error = null;
            string cs = SqlConnStr();
            if (cs == null) { error = "לא הוגדר SQL_SERVER בקובץ ה-.env."; return false; }
            if (string.IsNullOrWhiteSpace(jobName)) { error = "לא צוין שם JOB."; return false; }
            try
            {
                using (var conn = new SqlConnection(cs))
                {
                    conn.Open();
                    using (var cmd = new SqlCommand("msdb.dbo.sp_start_job", conn))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@job_name", jobName.Trim());
                        cmd.ExecuteNonQuery();
                    }
                }
                Console.WriteLine("▶️ הופעל JOB: " + jobName);
                return true;
            }
            catch (Exception ex) { error = ex.Message; return false; }
        }

        static object RunSqlJob(string jobName)
        {
            string err;
            bool ok = TryRunSqlJob(jobName, out err);
            if (ok) return new { ok = true };
            return new { ok = false, error = "שגיאה בהרצת ה-JOB: " + err };
        }

        static DateTime ParseSqlAgentDateTime(int runDate, int runTime)
        {
            try
            {
                string ds = runDate.ToString().PadLeft(8, '0');
                string ts = runTime.ToString().PadLeft(6, '0');
                int y = int.Parse(ds.Substring(0, 4)), mo = int.Parse(ds.Substring(4, 2)), da = int.Parse(ds.Substring(6, 2));
                int h = int.Parse(ts.Substring(0, 2)), mi = int.Parse(ts.Substring(2, 2)), se = int.Parse(ts.Substring(4, 2));
                return new DateTime(y, mo, da, h, mi, se);
            }
            catch { return DateTime.MinValue; }
        }

        static void MonitorJobAndReport(string jobName, string notifyEmail, DateTime startedAfter)
        {
            string cs = SqlConnStr();
            if (cs == null) return;
            DateTime deadline = DateTime.Now.AddMinutes(30);
            while (DateTime.Now < deadline)
            {
                System.Threading.Thread.Sleep(15000);
                try
                {
                    using (var conn = new SqlConnection(cs))
                    {
                        conn.Open();
                        string sql = @"SELECT TOP 1 h.run_status, h.run_date, h.run_time, h.message
                                       FROM msdb.dbo.sysjobs j
                                       JOIN msdb.dbo.sysjobhistory h ON j.job_id = h.job_id
                                       WHERE j.name = @n AND h.step_id = 0
                                       ORDER BY h.instance_id DESC";
                        using (var cmd = new SqlCommand(sql, conn))
                        {
                            cmd.Parameters.AddWithValue("@n", jobName);
                            using (var r = cmd.ExecuteReader())
                            {
                                if (r.Read())
                                {
                                    int rd = r["run_date"] is int ? (int)r["run_date"] : 0;
                                    int rt = r["run_time"] is int ? (int)r["run_time"] : 0;
                                    DateTime runAt = ParseSqlAgentDateTime(rd, rt);
                                    if (runAt >= startedAfter.AddSeconds(-5))
                                    {
                                        int status = r["run_status"] is int ? (int)r["run_status"] : -1;
                                        string msg = r["message"] as string ?? "";
                                        string statusText = status == 1 ? "הסתיים בהצלחה ✅" : (status == 0 ? "נכשל ❌" : "סטטוס לא ידוע (" + status + ")");
                                        SendMail(notifyEmail, "עדכון: JOB '" + jobName + "' " + statusText, "תוצאת ריצה: " + statusText + "\n\nפירוט: " + msg);
                                        Console.WriteLine("📬 נשלח עדכון סטטוס עבור JOB " + jobName + ": " + statusText);
                                        return;
                                    }
                                }
                            }
                        }
                    }
                }
                catch (Exception ex) { Console.WriteLine("⚠️ שגיאה במעקב אחרי JOB: " + ex.Message); }
            }
            Console.WriteLine("⏱️ הזמן הקצוב למעקב אחרי JOB " + jobName + " הסתיים בלי תוצאה סופית.");
        }


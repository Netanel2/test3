                "4) destPath: נתיב תיקייה מלא בווינדוס אם המייל מבקש להעתיק/לשמור את הקבצים שם. אם לא מוזכר — השאר ריק.\n" +
                "החזר JSON תקין בלבד: {\"requestType\":\"...\",\"value\":\"...\",\"sourceDir\":\"...\",\"destPath\":\"...\"}\n\n" +
                "נושא המייל: " + subject + "\nתוכן המייל: " + body;
            var b = new Dictionary<string, object> { { "contents", new object[] { new Dictionary<string, object> { { "role", "user" }, { "parts", new object[] { new Dictionary<string, object> { { "text", prompt } } } } } } } };
            try
            {
                string raw = ReadText(await Post(ApiBase + ChatModel + ":generateContent", b)).Replace("```json", "").Replace("```", "").Trim();
                Dictionary<string, object> d = null;
                try { d = js.DeserializeObject(raw) as Dictionary<string, object>; } catch { }
                if (d == null) { try { d = js.DeserializeObject(RepairLooseJson(raw)) as Dictionary<string, object>; } catch { } }
                if (d == null) return new { requestType = "none", value = "", sourceDir = "", destPath = "" };
                string rt = Str(d, "requestType") ?? "none";
                string val = Str(d, "value") ?? "";
                string src = Str(d, "sourceDir") ?? "";
                string dest = Str(d, "destPath") ?? "";

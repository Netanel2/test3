        static string FindFolderByDate(string sourceDir, string dateDigitsOnly)
        {
            if (string.IsNullOrWhiteSpace(sourceDir) || !Directory.Exists(sourceDir)) return null;
            var subdirs = Directory.GetDirectories(sourceDir);

            int day = -1, month = -1, year;
            if (dateDigitsOnly.Length >= 8) { int.TryParse(dateDigitsOnly.Substring(0, 2), out day); int.TryParse(dateDigitsOnly.Substring(2, 2), out month); int.TryParse(dateDigitsOnly.Substring(4, 4), out year); }
            else { int.TryParse(dateDigitsOnly.Length >= 2 ? dateDigitsOnly.Substring(0, 2) : "", out day); if (dateDigitsOnly.Length >= 4) int.TryParse(dateDigitsOnly.Substring(2, 2), out month); year = DateTime.Now.Year; } // אין שנה מפורשת -> מניחים שנה נוכחית, כדי לא להתבלבל בין אותו יום/חודש בשנים שונות

            // ניסיון 1: שם התיקייה מכיל בדיוק את הספרות המלאות (יום+חודש+שנה)
            if (day > 0 && month > 0)
            {
                string full8 = day.ToString("00") + month.ToString("00") + year.ToString("0000");
                var byFullName = subdirs.Where(d => new string(Path.GetFileName(d).Where(char.IsDigit).ToArray()) == full8).ToList();
                if (byFullName.Count == 1) return byFullName[0];
            }

            // ניסיון 2: תאריך השינוי האחרון (Date Modified) של התיקייה תואם ליום/חודש/שנה שנקבעו
            if (day > 0 && month > 0)
            {
                var byDate = subdirs.Where(d => { try { var lw = Directory.GetLastWriteTime(d); return lw.Day == day && lw.Month == month && lw.Year == year; } catch { return false; } }).ToList();
                if (byDate.Count == 1) return byDate[0];
            }
            return null;
        }

        static string FindFileBySequenceNumber(string[] dirs, string number)
        {
            var matches = new List<string>();
            foreach (var dir in dirs)
            {
                if (!Directory.Exists(dir)) continue;
                matches.AddRange(Directory.GetFiles(dir).Where(f => Path.GetFileNameWithoutExtension(f).Contains(number)));
            }
            return matches.Count == 1 ? matches[0] : null; // רק אם יש התאמה יחידה וודאית בכל התיקיות ביחד — אחרת לא עושים כלום
        }

        static bool SendFileByEmail(string to, string subject, string body, string filePath, out string error)
        {
            error = null;
            try
            {
                var app = new Outlook.Application();
                Outlook.MailItem mail = (Outlook.MailItem)app.CreateItem(Outlook.OlItemType.olMailItem);
                mail.To = to;
                mail.Subject = subject;
                mail.Body = body;
                mail.Attachments.Add(filePath);
                mail.Send();
                return true;
            }
            catch (Exception ex) { error = ex.Message; return false; }
        }

        static void CheckInboxForSmsFileRequests()
        {
            var app = new Outlook.Application();
            var ns = app.GetNamespace("MAPI");
            var inbox = ns.GetDefaultFolder(Outlook.OlDefaultFolders.olFolderInbox);
            var items = inbox.Items;
            items.Sort("[ReceivedTime]", true);
            int scanned = 0;
            foreach (object o in items)
            {
                scanned++; if (scanned > 100) break;
                var mail = o as Outlook.MailItem; if (mail == null) continue;
                if (!mail.UnRead) continue;
                string entryId; try { entryId = mail.EntryID; } catch { continue; }
                string dedupKey = "sms:" + entryId;
                if (ProcessedMailIds.Contains(dedupKey)) continue;

                string senderEmail = ResolveSenderEmail(mail);
                bool senderAllowed = !string.IsNullOrEmpty(senderEmail) && SmsFilesAllowedSenders.Contains(senderEmail.ToLowerInvariant());
                if (!senderAllowed) continue; // שולח לא מאושר — לא עושים כלום, בלי תגובה

                ProcessedMailIds.Add(dedupKey);
                try { mail.UnRead = false; mail.Save(); } catch { }

                string subj = mail.Subject ?? ""; string bodyText = mail.Body ?? "";
                var details = ExtractFileRequestDetails(subj, bodyText).GetAwaiter().GetResult();
                string requestType = "none", value = "", sourceDir = "", destPath = "";
                try
                {
                    requestType = (string)details.GetType().GetProperty("requestType").GetValue(details) ?? "none";
                    value = (string)details.GetType().GetProperty("value").GetValue(details) ?? "";
                    sourceDir = (string)details.GetType().GetProperty("sourceDir").GetValue(details) ?? "";
                    destPath = (string)details.GetType().GetProperty("destPath").GetValue(details) ?? "";
                }
                catch { }

                if (requestType == "number" && !string.IsNullOrWhiteSpace(value))
                {
                    string number = value;
                    string filePath = FindFileBySequenceNumber(SmsFilesDirs, number);
                    if (filePath == null)
                    {
                        SendMail(senderEmail, "לא נמצא קובץ עבור מספר " + number, "חיפשתי בתיקיות המוגדרות קובץ תואם למספר " + number + " ולא מצאתי התאמה יחידה וודאית. אנא בדוק את המספר או פנה ידנית.");
                        Console.WriteLine("📎 לא נמצאה התאמה יחידה למספר " + number + " (מ-" + senderEmail + ").");
                        continue;
                    }
                    if (!string.IsNullOrWhiteSpace(destPath))
                    {
                        if (!IsAllowed(destPath)) { Console.WriteLine("⛔ בקשה להעתיק אל נתיב לא מאושר (" + destPath + ") ממייל של " + senderEmail + " — לא בוצעה שום פעולה."); continue; }
                        try
                        {
                            Directory.CreateDirectory(destPath);
                            string target = Path.Combine(destPath, Path.GetFileName(filePath));
                            if (!File.Exists(target))
                            {
                                File.Copy(filePath, target);
                                try { File.AppendAllText(SmsAuditPath, DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + " | הועתק אל: " + destPath + " | מספר: " + number + " | קובץ: " + Path.GetFileName(filePath) + " | ביקש: " + senderEmail + "\n", new UTF8Encoding(false)); } catch { }
                                SendMail(senderEmail, "בוצע: הקובץ עבור מספר " + number + " הועתק", "הקובץ הועתק לתיקייה שביקשת: " + destPath);
                                Console.WriteLine("📎 הועתק קובץ '" + Path.GetFileName(filePath) + "' אל " + destPath + " (ביקש: " + senderEmail + ").");
                            }
                            else { SendMail(senderEmail, "הקובץ כבר קיים ביעד", "קובץ בשם זה כבר קיים בתיקייה " + destPath + " — לא הוחלף."); }
                        }
                        catch (Exception ex) { Console.WriteLine("⚠️ שגיאה בהעתקה אל " + destPath + ": " + ex.Message); }
                        continue;
                    }
                    string sendErr;
                    bool sent = SendFileByEmail(senderEmail, "בקשתך מספר " + number, "מצורף הקובץ המבוקש.", filePath, out sendErr);
                    if (sent)
                    {
                        try { File.AppendAllText(SmsAuditPath, DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + " | נשלח אל: " + senderEmail + " | מספר: " + number + " | קובץ: " + Path.GetFileName(filePath) + "\n", new UTF8Encoding(false)); } catch { }
                        Console.WriteLine("📎 נשלח קובץ '" + Path.GetFileName(filePath) + "' אל " + senderEmail + " (מספר " + number + ").");
                    }
                    else { Console.WriteLine("⚠️ שגיאה בשליחת קובץ אל " + senderEmail + ": " + sendErr); }
                    continue;
                }

                if (requestType == "date" && !string.IsNullOrWhiteSpace(value))
                {
                    string dateDigits = new string(value.Where(char.IsDigit).ToArray());
                    if (string.IsNullOrWhiteSpace(sourceDir) || !Directory.Exists(sourceDir))
                    {
                        Console.WriteLine("📎 לא הצלחתי לזהות תיקיית מקור ידועה עבור בקשת התאריך של " + senderEmail + " — לא נעשה דבר.");
                        continue;
                    }
                    string folder = FindFolderByDate(sourceDir, dateDigits);
                    if (folder == null)
                    {
                        SendMail(senderEmail, "לא נמצאה תיקייה עבור תאריך " + value, "חיפשתי ב-" + sourceDir + " תיקייה תואמת לתאריך " + value + " ולא מצאתי התאמה יחידה וודאית.");
                        Console.WriteLine("📎 לא נמצאה תיקיית תאריך תואמת (" + value + ") ב-" + sourceDir + " (מ-" + senderEmail + ").");
                        continue;
                    }
                    if (string.IsNullOrWhiteSpace(destPath))
                    {
                        SendMail(senderEmail, "צריך יעד להעתקה", "מצאתי את התיקייה המבוקשת (" + value + "), אבל בקשות של תיקייה שלמה דורשות שתציין נתיב יעד להעתקה. אנא שלח שוב וציין לאן להעתיק.");
                        continue;
                    }
                    if (!IsAllowed(destPath)) { Console.WriteLine("⛔ בקשה להעתיק תיקיית תאריך אל נתיב לא מאושר (" + destPath + ") ממייל של " + senderEmail + " — לא בוצעה שום פעולה."); continue; }
                    try
                    {
                        Directory.CreateDirectory(destPath);
                        var allFiles = Directory.GetFiles(folder);
                        int copied = 0, skipped = 0;
                        lock (FsProgressLock) { FsProgressDone = 0; FsProgressTotal = allFiles.Length; FsProgressCurrentFile = ""; }
                        for (int fi = 0; fi < allFiles.Length; fi++)
                        {
                            var f = allFiles[fi];
                            string target = Path.Combine(destPath, Path.GetFileName(f));
                            lock (FsProgressLock) { FsProgressCurrentFile = Path.GetFileName(f); }
                            if (File.Exists(target)) { skipped++; }
                            else { File.Copy(f, target); copied++; }
                            lock (FsProgressLock) { FsProgressDone = fi + 1; }
                            if (allFiles.Length > 20 && (fi + 1) % 10 == 0) Console.WriteLine("📎 התקדמות העתקה: " + (fi + 1) + "/" + allFiles.Length + " (" + Math.Round(100.0 * (fi + 1) / allFiles.Length) + "%)");
                        }
                        try { File.AppendAllText(SmsAuditPath, DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + " | הועתקה תיקיית תאריך: " + value + " | מ: " + folder + " | אל: " + destPath + " | קבצים: " + copied + " | ביקש: " + senderEmail + "\n", new UTF8Encoding(false)); } catch { }
                        SendMail(senderEmail, "בוצע: קבצי " + value + " הועתקו", "הועתקו " + copied + " קבצים (דולגו " + skipped + " שכבר קיימים) מהתיקייה " + folder + " אל " + destPath + ".");
                        Console.WriteLine("📎 הועתקו " + copied + " קבצים מתיקיית " + value + " אל " + destPath + " (ביקש: " + senderEmail + ").");
                    }
                    catch (Exception ex) { Console.WriteLine("⚠️ שגיאה בהעתקת תיקיית תאריך אל " + destPath + ": " + ex.Message); }
                    continue;
                }

                Console.WriteLine("📎 לא זוהתה בקשה ברורה למספר/תאריך במייל מ-" + senderEmail + " — לא נעשה דבר.");
            }
        }


        static List<Chunk> RetrieveRelevantChunks(string query, int topK)
        {
            List<Chunk> snap; lock (indexLock) snap = new List<Chunk>(index);
            if (snap.Count == 0) return snap;
            if (snap.Count <= SEND_ALL_THRESHOLD) return snap;
            try
            {
                var qv = EmbedBatch(new List<string> { query }).GetAwaiter().GetResult()[0];
                return snap.Select(c => new { c, s = Cosine(qv, c.Embedding) }).OrderByDescending(x => x.s).Take(topK).Select(x => x.c).ToList();
            }
            catch { return snap.Take(topK).ToList(); }
        }

        static async Task<object> ExtractFileRequestDetails(string subject, string body)
        {

        static void CheckInboxForJobTriggers()
        {
            lock (OutlookLock)
            {
            var app = new Outlook.Application();
            var ns = app.GetNamespace("MAPI");
            var inbox = ns.GetDefaultFolder(Outlook.OlDefaultFolders.olFolderInbox);
            var items = inbox.Items;
            items.Sort("[ReceivedTime]", true);
            int scanned = 0;
            foreach (object o in items)
            {
                scanned++; if (scanned > 100) break;
                var mail = o as Outlook.MailItem; if (mail == null) continue;
                if (!mail.UnRead) continue;
                string entryId; try { entryId = mail.EntryID; } catch { continue; }
                if (ProcessedMailIds.Contains(entryId)) continue;

                string senderEmail = ResolveSenderEmail(mail);
                bool senderAllowed = !string.IsNullOrEmpty(senderEmail) && AutoJobAllowedSenders.Contains(senderEmail.ToLowerInvariant());
                if (!senderAllowed) continue;

                ProcessedMailIds.Add(entryId);
                try { mail.UnRead = false; mail.Save(); } catch { }

                string subj = mail.Subject ?? ""; string bodyText = mail.Body ?? "";
                var classification = ClassifyJobEmailIntent(subj, bodyText, AutoJobAllowedJobs).GetAwaiter().GetResult();
                string jobName = "", confidence = "low", reason = "";
                try
                {
                    jobName = (string)classification.GetType().GetProperty("jobName").GetValue(classification) ?? "";
                    confidence = (string)classification.GetType().GetProperty("confidence").GetValue(classification) ?? "low";
                    reason = (string)classification.GetType().GetProperty("reason").GetValue(classification) ?? "";
                }
                catch { }

                if (string.IsNullOrWhiteSpace(jobName)) continue; // המייל לא זוהה כקשור לאף JOB מהרשימה המותרת

                // הגנה כפולה: לוודא שהשם שחזר מה-AI באמת קיים ברשימת המותרים, מילה במילה
                string matchedJob = AutoJobAllowedJobs.FirstOrDefault(j => string.Equals(j, jobName, StringComparison.OrdinalIgnoreCase));
                if (matchedJob == null) continue;

                Console.WriteLine("🧭 זיהוי AI: JOB='" + matchedJob + "' ביטחון=" + confidence + " נימוק: " + reason);

                if (confidence == "high")
                {
                    string startErr; DateTime startedAt = DateTime.Now;
                    bool started = TryRunSqlJob(matchedJob, out startErr);
                    if (started)
                    {
                        SendAutoMail(senderEmail, "אושר: JOB '" + matchedJob + "' הופעל אוטומטית", "זיהיתי מהמייל שלך (ברמת ביטחון גבוהה) שצריך להריץ את '" + matchedJob + "', והפעלתי אותו כעת. נעדכן כשתהיה תוצאה סופית.\n\nנימוק הזיהוי: " + reason);
                        Task.Run(() => MonitorJobAndReport(matchedJob, senderEmail, startedAt));
                    }
                    else
                    {
                        SendAutoMail(senderEmail, "שגיאה בהפעלת JOB '" + matchedJob + "'", "זיהיתי בקשה להריץ את '" + matchedJob + "' אך ההפעלה נכשלה: " + startErr);
                    }
                }
                else
                {
                    SendAutoMail(senderEmail, "צריך אישור ידני: אולי יש להריץ '" + matchedJob + "'", "קיבלתי מייל שאולי קשור להרצת JOB '" + matchedJob + "', אבל רמת הביטחון שלי נמוכה מדי (" + confidence + ") כדי להריץ אותו לבד.\n\nנימוק: " + reason + "\n\nאם אכן צריך להריץ אותו, תוכל לבקש ממני ידנית דרך הצ'אט: \"תריץ מחדש את JOB '" + matchedJob + "'\".");

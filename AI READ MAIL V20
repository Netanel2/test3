    // צילום כל החלונות העצמאיים הפתוחים כרגע, בכל תהליך שהוא
    static HashSet<IntPtr> GetAllTopWindowHandles()
    {
        var set = new HashSet<IntPtr>();
        AutomationElementCollection windows = AutomationElement.RootElement.FindAll(TreeScope.Children, Condition.TrueCondition);
        foreach (AutomationElement w in windows)
        {
            try { set.Add(new IntPtr(w.Current.NativeWindowHandle)); } catch { }

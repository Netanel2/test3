                ((message.Contains("נשלח") || message.Contains("שולח") || message.Contains("שולחים") || message.Contains("נשלחים") || message.Contains("מגיע") || message.Contains("מגיעים")) && (message.Contains("כל כמה") || message.Contains("מתי") || message.Contains("כמה פעמים") || message.Contains("באיזו תדירות")));

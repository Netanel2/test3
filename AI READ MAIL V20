        static bool ReadMailCore(string query, int count, bool unreadOnly, string dateFilter, string folder, out List<MailInfo> mails, out string error)
        {
            mails = new List<MailInfo>(); error = null;
            lock (OutlookLock)
            {
                var app = new Outlook.Application();
                var ns = app.GetNamespace("MAPI");
                Outlook.MAPIFolder targetFolder;
                if (!string.IsNullOrWhiteSpace(folder))
                {
                    targetFolder = FindFolderByName(ns, folder.Trim());
                    if (targetFolder == null) { error = "לא נמצאה תיקייה בשם: " + folder; return false; }
                }
                else { targetFolder = ns.GetDefaultFolder(Outlook.OlDefaultFolders.olFolderInbox); }
                var items = targetFolder.Items;
                items.Sort("[ReceivedTime]", true);

                bool isFiltering = unreadOnly || dateFilter != "all" || !string.IsNullOrEmpty(query);
                int scanLimit = isFiltering ? 2000 : 500;
                DateTime today = DateTime.Today;

                int scanned = 0;
                foreach (object o in items)
                {
                    if (mails.Count >= count) break;
                    scanned++; if (scanned > scanLimit) break;
                    var mail = o as Outlook.MailItem; if (mail == null) continue;

                    if (unreadOnly && !mail.UnRead) continue;

                    DateTime received = DateTime.MinValue; bool hasDate = true;
                    try { received = mail.ReceivedTime; } catch { hasDate = false; }
                    if (dateFilter == "today" && (!hasDate || received.Date != today)) continue;
                    if (dateFilter == "yesterday" && (!hasDate || received.Date != today.AddDays(-1))) continue;

                    string subj = mail.Subject ?? "(ללא נושא)";
                    string from = mail.SenderName ?? "";
                    string bodyText = mail.Body ?? "";
                    if (!string.IsNullOrEmpty(query) && bodyText.Contains(AutoMsgMarker)) continue; // מדלגים על הודעות אוטומטיות של המערכת עצמה בחיפוש מילות מפתח רגיל
                    if (!string.IsNullOrEmpty(query))
                    {
                        string hay = (subj + " " + from + " " + bodyText).ToLowerInvariant();
                        var terms = query.Split(',').Select(t => t.Trim().ToLowerInvariant()).Where(t => t.Length > 0).ToArray();
                        if (terms.Length > 0 && !terms.Any(t => hay.Contains(t))) continue;
                    }
                    string preview = bodyText.Replace("\r", " ").Replace("\n", " ").Trim();
                    if (preview.Length > 200) preview = preview.Substring(0, 200) + "...";
                    string date = hasDate ? received.ToString("dd/MM/yyyy HH:mm") : "";
                    mails.Add(new MailInfo { subject = subj, from = from, date = date, preview = preview, unread = mail.UnRead });
                }
                Console.WriteLine("📧 הוחזרו " + mails.Count + " מיילים.");
                return true;
            }
        }

        static object ReadMail(string query, int count, bool unreadOnly = false, string dateFilter = "all", string folder = "")
        {
            List<MailInfo> mails; string err;
            bool ok = ReadMailCore(query, count, unreadOnly, dateFilter, folder, out mails, out err);
            if (!ok) return new { ok = false, error = err };
            return new { ok = true, mails = mails };
        }


        static void ScanInboxForLearnableExchanges()
        {
            lock (OutlookLock)
            {
            var app = new Outlook.Application();
            var ns = app.GetNamespace("MAPI");
            var inbox = ns.GetDefaultFolder(Outlook.OlDefaultFolders.olFolderInbox);
            var items = inbox.Items;
            items.Sort("[ReceivedTime]", true);
            var groups = new Dictionary<string, List<Outlook.MailItem>>();
            int scanned = 0;
            foreach (object o in items)
            {
                scanned++; if (scanned > 300) break;
                var mail = o as Outlook.MailItem; if (mail == null) continue;
                try { if ((mail.Body ?? "").Contains(AutoMsgMarker)) continue; } catch { } // מדלגים על הודעות שהמערכת עצמה שלחה — לא ללמוד מעצמנו
                string topic = ""; try { topic = mail.ConversationTopic; } catch { }
                if (string.IsNullOrWhiteSpace(topic)) { try { topic = mail.Subject; } catch { } }
                if (string.IsNullOrWhiteSpace(topic)) continue;
                if (!groups.ContainsKey(topic)) groups[topic] = new List<Outlook.MailItem>();
                groups[topic].Add(mail);
            }
            Console.WriteLine("[אבחון-למידה] נסרקו " + scanned + " מיילים, נמצאו " + groups.Count + " שרשורים (נושאים) שונים.");
            int candidateCount = 0, newCount = 0, multiMsgCount = 0, multiSenderCount = 0;
            int processedThisCycle = 0;
            foreach (var kv in groups)
            {
                string topic = kv.Key;
                var msgs = kv.Value;
                bool isNew = !ProcessedEmailTopics.Contains(topic);
                if (isNew) newCount++;
                if (msgs.Count >= 2) multiMsgCount++;
                int distinctSendersDbg = msgs.Select(m => { try { return (ResolveSenderEmail(m) ?? "").ToLowerInvariant(); } catch { return ""; } }).Where(s => s.Length > 0).Distinct().Count();
                if (msgs.Count >= 2 && distinctSendersDbg >= 2) multiSenderCount++;
                if (isNew && msgs.Count >= 2 && distinctSendersDbg >= 2) candidateCount++;

                if (processedThisCycle >= 5) continue; // ממשיכים לספור לאבחון גם אם עברנו את המכסה, אבל לא מעבדים בפועל
                if (!isNew) continue;
                if (msgs.Count < 2) { continue; } // צריך לפחות הודעה ראשונה + תגובה כדי שיהיה "בעיה+פתרון"

                int distinctSenders = distinctSendersDbg;
                if (distinctSenders < 2) continue; // אותו שולח בלבד (למשל דוח אוטומטי חוזר) — לא התכתבות אמיתית, מדלגים בלי לסמן כמעובד

                ProcessedEmailTopics.Add(topic);
                try { File.AppendAllText(LearnedEmailTopicsPath, topic + "\n", new UTF8Encoding(false)); } catch { }
                processedThisCycle++;

                var sorted = msgs.OrderBy(m => { try { return m.ReceivedTime; } catch { return DateTime.MinValue; } }).ToList();
                string problem = sorted[0].Body ?? "";
                string solution = sorted[sorted.Count - 1].Body ?? "";

                Console.WriteLine("[אבחון-למידה] מעבד שרשור: '" + topic + "' (" + msgs.Count + " הודעות, " + distinctSenders + " שולחים שונים)");
                string fact = ExtractSupportFact(problem, solution).GetAwaiter().GetResult();
                Console.WriteLine("[אבחון-למידה] תוצאת AI עבור '" + topic + "': " + (fact ?? "(NONE / לא נמצא ערך ללמידה)"));
                if (string.IsNullOrWhiteSpace(fact)) continue;

                try
                {
                    File.AppendAllText(LearnedPath, "=== נלמד ממייל תמיכה " + DateTime.Now.ToString("yyyy-MM-dd HH:mm") + " ===\n" + fact.Trim() + "\n\n", new UTF8Encoding(false));
                    var chunk = new Chunk { Source = "ידע נלמד ממיילי תמיכה", Text = fact.Trim() };
                    chunk.Embedding = EmbedBatch(new List<string> { chunk.Text }).GetAwaiter().GetResult()[0];
                    lock (indexLock) { index.Add(chunk); File.WriteAllText(IndexPath, js.Serialize(index), new UTF8Encoding(false)); }
                    Console.WriteLine("🧠📧 נלמד ממייל תמיכה (נושא: " + topic + "): " + fact);
                }
                catch (Exception ex) { Console.WriteLine("⚠️ שגיאה בשמירת למידה ממייל: " + ex.Message); }
            }
            Console.WriteLine("[אבחון-למידה] סיכום: " + groups.Count + " שרשורים סה\"כ | " + newCount + " חדשים (לא מעובדים) | " + multiMsgCount + " עם 2+ הודעות | " + multiSenderCount + " עם 2+ שולחים שונים | " + candidateCount + " מועמדים חדשים שעומדים בכל התנאים.");
        }

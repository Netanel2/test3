                    using (var wb = new XLWorkbook(path))
                    {
                        if (wb.Worksheets.Contains(req.sheet)) return new { ok = false, error = "כבר קיים גיליון בשם זה." };
                        wb.Worksheets.Add(req.sheet);
                        wb.Save();
                    }
                    Console.WriteLine("📊 נוסף גיליון '" + req.sheet + "' לקובץ: " + path);
                    return new { ok = true, action = "addSheet", path = path, sheet = req.sheet };
                }

                if (action == "compute")
                {
                    if (!File.Exists(path)) return new { ok = false, error = "הקובץ לא קיים." };
                    string opv = (req.op ?? "sum").ToLowerInvariant();
                    double result = 0; int countNum = 0;
                    using (var wb = new XLWorkbook(path))
                    {
                        var ws2 = GetOrCreateWorksheet(wb, req.sheet);
                        var vals = new List<double>();
                        foreach (var c in ws2.Column(column).CellsUsed())
                        {
                            double dv;
                            if (double.TryParse(c.GetString(), out dv)) vals.Add(dv);
                        }
                        countNum = vals.Count;
                        if (opv == "sum") result = vals.Sum();
                        else if (opv == "average") result = vals.Count > 0 ? vals.Average() : 0;
                        else if (opv == "max") result = vals.Count > 0 ? vals.Max() : 0;
                        else if (opv == "min") result = vals.Count > 0 ? vals.Min() : 0;
                        else if (opv == "count") result = countNum;
                    }
                    return new { ok = true, action = "compute", path = path, column = column, op = opv, result = result, countNum = countNum };
                }

                if (action == "sort")
                {
                    if (!File.Exists(path)) return new { ok = false, error = "הקובץ לא קיים." };
                    using (var wb = new XLWorkbook(path))
                    {
                        var ws2 = GetOrCreateWorksheet(wb, req.sheet);
                        var used = ws2.RangeUsed();
                        if (used == null) return new { ok = false, error = "אין נתונים למיין." };
                        int colIdx;
                        try { colIdx = XLHelper.GetColumnNumberFromLetter(column) - used.FirstColumn().ColumnNumber() + 1; } catch { colIdx = 1; }
                        var sortOrder = (req.order == "desc") ? XLSortOrder.Descending : XLSortOrder.Ascending;
                        used.Sort(colIdx, sortOrder);
                        wb.Save();
                    }
                    Console.WriteLine("📊 מוין לפי עמודה " + column + ": " + path);
                    return new { ok = true, action = "sort", path = path, column = column, order = req.order };
                }

                if (action == "findDuplicates")
                {
                    if (!File.Exists(path)) return new { ok = false, error = "הקובץ לא קיים." };
                    var counts = new Dictionary<string, int>();
                    using (var wb = new XLWorkbook(path))
                    {
                        var ws2 = GetOrCreateWorksheet(wb, req.sheet);
                        foreach (var c in ws2.Column(column).CellsUsed())
                        {
                            string s = c.GetString();
                            if (string.IsNullOrWhiteSpace(s)) continue;
                            if (!counts.ContainsKey(s)) counts[s] = 0;
                            counts[s]++;
                        }
                    }
                    var dups = counts.Where(kv => kv.Value > 1).Select(kv => new { value = kv.Key, count = kv.Value }).ToList();
                    return new { ok = true, action = "findDuplicates", path = path, column = column, duplicates = dups };
                }

                if (action != "append")
                {
                    using (var wb = new XLWorkbook())
                    {
                        string sheetName = string.IsNullOrWhiteSpace(req.sheet) ? "Sheet1" : req.sheet;
                        wb.Worksheets.Add(sheetName);
                        wb.SaveAs(path);
                    }
                    Console.WriteLine("📊 נוצר קובץ אקסל ריק: " + path);
                    return new { ok = true, action = "create", path = path };
                }
                else
                {
                    XLWorkbook wb; IXLWorksheet ws;
                    bool existed = File.Exists(path);
                    if (existed) { wb = new XLWorkbook(path); ws = GetOrCreateWorksheet(wb, req.sheet); }
                    else { wb = new XLWorkbook(); ws = wb.Worksheets.Add(string.IsNullOrWhiteSpace(req.sheet) ? "Sheet1" : req.sheet); }

                    int startRow = 1;
                    try { var lastUsed = ws.LastRowUsed(); if (lastUsed != null) startRow = lastUsed.RowNumber() + 1; } catch { }

                    int added = 0;
                    if (rows != null)
                    {
                        for (int r = 0; r < rows.Count; r++)
                        {
                            var rowData = rows[r];
                            for (int c = 0; c < rowData.Count; c++) ws.Cell(startRow + r, c + 1).Value = rowData[c];
                            added++;
                        }
                    }
                    wb.SaveAs(path);
                    wb.Dispose();
                    Console.WriteLine("📊 נוספו " + added + " שורות לקובץ אקסל: " + path + (existed ? " (קיים)" : " (חדש)"));
                    return new { ok = true, action = "append", path = path, rowsAdded = added, wasExisting = existed };
                }
            }
            catch (Exception ex) { return new { ok = false, error = "שגיאת אקסל: " + ex.Message }; }
        }

        static object ExcelRead(string path, string range, string column, string sheet = "")
        {
            if (string.IsNullOrWhiteSpace(path)) return new { ok = false, error = "חסר נתיב לקובץ" };
            if (!IsAllowed(path)) return new { ok = false, error = "הנתיב מחוץ לתיקיות המותרות." };
            if (!File.Exists(path)) return new { ok = false, error = "הקובץ לא קיים." };
            try
            {
                using (var wb = new XLWorkbook(path))
                {
                    var ws = GetOrCreateWorksheet(wb, sheet);

                    var result = new List<List<string>>();
                    if (!string.IsNullOrWhiteSpace(column))
                    {
                        var colCells = ws.Column(column).CellsUsed();
                        foreach (var c in colCells) result.Add(new List<string> { c.GetString() });
                    }
                    else if (!string.IsNullOrWhiteSpace(range))
                    {
                        var rng = ws.Range(range);
                        foreach (var r in rng.Rows())
                        {
                            var rowVals = new List<string>();
                            foreach (var c in r.Cells()) rowVals.Add(c.GetString());
                            result.Add(rowVals);
                        }
                    }
                    else
                    {
                        var used = ws.RangeUsed();
                        if (used != null)
                            foreach (var r in used.Rows())
                            {
                                var rowVals = new List<string>();

<script>
if(window.marked){marked.setOptions({breaks:true,gfm:true});}
var q=document.getElementById('q'),drop=document.getElementById('drop'),fi=document.getElementById('fi');
var learnMode=false;
function stats(){fetch('/api/sources').then(function(r){return r.json();}).then(function(d){document.getElementById('stats').innerHTML=d.sources.length+' מדריכים · <b>'+d.chunks+'</b> קטעים';});}

        static void CopyDirectoryRecursive(string sourceDir, string destDir, bool move, ref int done, ref int skipped, List<string> errors)
        {
            Directory.CreateDirectory(destDir);
            foreach (var f in Directory.GetFiles(sourceDir))
            {
                lock (FsProgressLock) { FsProgressCurrentFile = Path.GetFileName(f); }
                string target = Path.Combine(destDir, Path.GetFileName(f));
                try { if (File.Exists(target)) { skipped++; } else { if (move) File.Move(f, target); else File.Copy(f, target); done++; } }
                catch (Exception e) { errors.Add(Path.GetFileName(f) + ": " + e.Message); }
                lock (FsProgressLock) { FsProgressDone = done + skipped; }
            }
            foreach (var sub in Directory.GetDirectories(sourceDir))
                CopyDirectoryRecursive(sub, Path.Combine(destDir, Path.GetFileName(sub)), move, ref done, ref skipped, errors);
        }


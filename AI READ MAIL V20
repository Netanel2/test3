using System;
using System.Diagnostics;
using System.Threading;
using System.Windows.Automation;

class Program
{
    static void Main()
    {
        string exePath = @"C:\Users\netanelma\Desktop\מנוע דוחות.exe";

        Console.WriteLine("פותח את התוכנה...");
        Process proc = Process.Start(exePath);
        try { proc.WaitForInputIdle(5000); } catch { }

        Console.WriteLine("מחפש את חלון 'בחירת דוח'...");
        AutomationElement reportWindow = FindWindowByProcessId(proc.Id, 15);

        if (reportWindow == null)
        {
            Console.WriteLine("לא מצאתי את החלון.");
            Console.ReadLine();
            return;
        }

        Console.WriteLine("נמצא. בוחר קטגוריה 'עדכונים-תפעול'...");
        SelectItemInside(reportWindow, "cmbCategory", "עדכונים-תפעול");
        Thread.Sleep(1500);

        Console.WriteLine("בוחר את הדוח 'קליטת מעברים XML'...");
        SelectItemInside(reportWindow, "lstReports", "קליטת מעברים XML");
        Thread.Sleep(500);

        Console.WriteLine("לוחץ על הכפתור 'בחירת דוח'...");
        ClickButton(reportWindow, "btnChooseReport");

        // *** החלק החדש: מחכים שהחלון הבא ('1152 - קליטת מעברים XML') ייפתח, ומדפיסים מה יש בו ***
        Console.WriteLine("ממתין שהחלון הבא ייפתח...");
        Thread.Sleep(2000);

        AutomationElement nextWindow = null;
        for (int i = 0; i < 20 && nextWindow == null; i++)
        {
            AutomationElementCollection windows = AutomationElement.RootElement.FindAll(
                TreeScope.Children, Condition.TrueCondition);

            foreach (AutomationElement win in windows)
            {
                int wpid = 0;
                try { wpid = win.Current.ProcessId; } catch { continue; }

                // מחפשים חלון חדש מאותו תהליך, שהוא לא חלון "בחירת דוח" עצמו
                if (wpid == proc.Id && win.Current.Name != "בחירת דוח" && !string.IsNullOrWhiteSpace(win.Current.Name))
                {
                    nextWindow = win;
                    break;
                }
            }
            if (nextWindow == null) Thread.Sleep(500);
        }

        if (nextWindow == null)
        {
            Console.WriteLine("לא נפתח חלון נוסף. אולי צריך יותר זמן המתנה - תגיד לי.");
            Console.ReadLine();
            return;
        }

        Console.WriteLine("נמצא חלון חדש: '" + nextWindow.Current.Name + "'");
        Console.WriteLine(new string('-', 60));
        Console.WriteLine("אלה כל השדות/כפתורים בחלון הזה:");
        Console.WriteLine(new string('-', 60));

        AutomationElementCollection allControls = nextWindow.FindAll(
            TreeScope.Descendants, Condition.TrueCondition);

        foreach (AutomationElement el in allControls)
        {
            string type = el.Current.ControlType.ProgrammaticName;
            string name = el.Current.Name;
            string autoId = el.Current.AutomationId;
            Console.WriteLine($"סוג: {type,-35} | שם: '{name}' | מזהה: '{autoId}'");
        }

        Console.WriteLine(new string('-', 60));
        Console.WriteLine("תעתיק לי את כל הרשימה למעלה.");
        Console.WriteLine("לחץ Enter לסגירה...");
        Console.ReadLine();
    }

    static AutomationElement FindWindowByProcessId(int pid, int timeoutSeconds)
    {
        for (int i = 0; i < timeoutSeconds * 2; i++)
        {
            AutomationElementCollection windows = AutomationElement.RootElement.FindAll(
                TreeScope.Children, Condition.TrueCondition);

            foreach (AutomationElement win in windows)
            {
                int wpid = 0;
                try { wpid = win.Current.ProcessId; } catch { continue; }
                if (wpid == pid) return win;
            }
            Thread.Sleep(500);
        }
        return null;
    }

    static void SelectItemInside(AutomationElement parentWindow, string containerAutomationId, string itemName)
    {
        AutomationElement container = parentWindow.FindFirst(TreeScope.Descendants,
            new PropertyCondition(AutomationElement.AutomationIdProperty, containerAutomationId));

        if (container == null)
        {
            Console.WriteLine("   (!) לא נמצא: " + containerAutomationId);
            return;
        }

        AutomationElement item = null;
        for (int i = 0; i < 10 && item == null; i++)
        {
            item = container.FindFirst(TreeScope.Descendants,
                new PropertyCondition(AutomationElement.NameProperty, itemName));
            if (item == null) Thread.Sleep(300);
        }

        if (item == null)
        {
            Console.WriteLine("   (!) לא נמצא פריט בשם: " + itemName);
            return;
        }

        object pattern;
        if (item.TryGetCurrentPattern(SelectionItemPattern.Pattern, out pattern))
        {
            ((SelectionItemPattern)pattern).Select();
        }
        else if (item.TryGetCurrentPattern(InvokePattern.Pattern, out pattern))
        {
            ((InvokePattern)pattern).Invoke();
        }
    }

    static void ClickButton(AutomationElement parentWindow, string buttonAutomationId)
    {
        AutomationElement button = parentWindow.FindFirst(TreeScope.Descendants,
            new PropertyCondition(AutomationElement.AutomationIdProperty, buttonAutomationId));

        if (button == null)
        {
            Console.WriteLine("   (!) לא נמצא כפתור: " + buttonAutomationId);
            return;
        }

        object pattern;
        if (button.TryGetCurrentPattern(InvokePattern.Pattern, out pattern))
        {
            ((InvokePattern)pattern).Invoke();
        }
    }
}

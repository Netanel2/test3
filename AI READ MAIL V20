        static async Task<Dictionary<string, object>> ReadJson(HttpListenerRequest request)
        { string b; using (var r = new StreamReader(request.InputStream, Encoding.UTF8)) b = await r.ReadToEndAsync(); return js.DeserializeObject(b) as Dictionary<string, object>; }
        static string Str(Dictionary<string, object> d, string k) { return (d != null && d.ContainsKey(k) && d[k] != null) ? d[k].ToString() : null; }

        static async Task<object> DetectIntent(string message)
        {
            if (string.IsNullOrWhiteSpace(message)) return new { kind = "none" };
            bool maybeFile = message.Contains("\\") || message.Contains(":");
            bool maybeMail = message.Contains("מייל") || message.Contains("מיילים") || message.Contains("אאוטלוק") || message.Contains("outlook") || message.Contains("דוא") || message.Contains("הודעות") || message.Contains("שלח");
            if (!maybeFile && !maybeMail) return new { kind = "none" };

            string prompt =
                "המשתמש כתב הודעה. סווג אותה והחזר JSON בלבד (בלי טקסט או סימני קוד):\n" +
                "אם בקשה להעברת/העתקת קבצים: {kind:file, op:copy או move, source:נתיב, dest:נתיב, pattern:* }\n" +
                "אם בקשה לקרוא/לחפש מיילים ב-Outlook: {kind:mail, query:מילות חיפוש בנושא/שולח/גוף המייל או ריק, count:מספר, unreadOnly:true או false, dateFilter:today או yesterday או all, folder:שם תיקייה באאוטלוק לחיפוש בה או ריק לתיבה הנכנסת}\n" +
                "אם בקשה לשלוח מייל: {kind:sendmail, to:כתובת/כתובות נמענים מופרדות בפסיק, subject:נושא המייל, body:תוכן המייל}. אל תמציא כתובת מייל אם המשתמש לא נתן אחת מפורשת — במקרה כזה השאר to ריק.\n" +
                "unreadOnly=true רק אם המשתמש מדבר במפורש על מיילים שלא נקראו/לא נקראו. dateFilter=today אם השאלה על היום, yesterday אם על אתמול, אחרת all.\n" +
                "חשוב: מילים כמו 'היום', 'אתמול', 'לא נקראו' הן סינון (dateFilter/unreadOnly) ולא טקסט לחיפוש — אל תשים אותן בשדה query.\n" +
                "אחרת: {kind:none}\n" +
                "op=move רק אם 'העבר'/'תעביר'/'הזז'. אם לא צוין סינון pattern=*. העתק נתיבים בדיוק.\n" +
                "החזר JSON תקין עם מרכאות כפולות סטנדרטיות.\n\nההודעה: " + message;
            var body = new Dictionary<string, object> { { "contents", new object[] { new Dictionary<string, object> { { "role", "user" }, { "parts", new object[] { new Dictionary<string, object> { { "text", prompt } } } } } } } };
            string raw = ReadText(await Post(ApiBase + ChatModel + ":generateContent", body)).Replace("```json", "").Replace("```", "").Trim();
            try
            {
                var d = js.DeserializeObject(raw) as Dictionary<string, object>;
                string kind = Str(d, "kind");
                if (kind == "file")
                {
                    string op = Str(d, "op"); if (op != "move") op = "copy";
                    string src = Str(d, "source"), dst = Str(d, "dest"), pat = Str(d, "pattern"); if (string.IsNullOrWhiteSpace(pat)) pat = "*";
                    if (string.IsNullOrWhiteSpace(src) || string.IsNullOrWhiteSpace(dst)) return new { kind = "none" };
                    return new { kind = "file", op = op, source = src, dest = dst, pattern = pat };
                }
                if (kind == "mail")
                {
                    string query = Str(d, "query") ?? "";
                    bool unreadOnly = false; try { unreadOnly = d.ContainsKey("unreadOnly") && Convert.ToBoolean(d["unreadOnly"]); } catch { }
                    string dateFilter = Str(d, "dateFilter"); if (dateFilter != "today" && dateFilter != "yesterday") dateFilter = "all";
                    string folder = Str(d, "folder") ?? "";
                    int count = (unreadOnly || dateFilter != "all") ? 50 : 10;
                    try { var cc = Str(d, "count"); if (!string.IsNullOrEmpty(cc)) count = Convert.ToInt32(Convert.ToDouble(cc)); } catch { }
                    if (count < 1) count = 10; if (count > 50) count = 50;
                    return new { kind = "mail", query = query, count = count, unreadOnly = unreadOnly, dateFilter = dateFilter, folder = folder };
                }
                if (kind == "sendmail")
                {
                    string to = Str(d, "to") ?? "";
                    string subject = Str(d, "subject") ?? "";
                    string mbody = Str(d, "body") ?? "";
                    return new { kind = "sendmail", to = to, subject = subject, body = mbody };
                }
                return new { kind = "none" };
            }
            catch { return new { kind = "none" }; }
        }

        static Outlook.MAPIFolder FindFolderByName(Outlook.NameSpace ns, string name)
        {
            foreach (Outlook.MAPIFolder store in ns.Folders)
            {
                var found = SearchFolderTree(store, name);
                if (found != null) return found;
            }
            return null;
        }
        static Outlook.MAPIFolder SearchFolderTree(Outlook.MAPIFolder folder, string name)
        {
            try { if (folder.Name.IndexOf(name, StringComparison.OrdinalIgnoreCase) >= 0) return folder; } catch { }
            try
            {
                foreach (Outlook.MAPIFolder sub in folder.Folders)
                {
                    var found = SearchFolderTree(sub, name);
                    if (found != null) return found;
                }
            }
            catch { }
            return null;
        }

        static object ReadMail(string query, int count, bool unreadOnly = false, string dateFilter = "all", string folder = "")
        {
            var app = new Outlook.Application();
            var ns = app.GetNamespace("MAPI");
            Outlook.MAPIFolder targetFolder;
            if (!string.IsNullOrWhiteSpace(folder))
            {
                targetFolder = FindFolderByName(ns, folder.Trim());
                if (targetFolder == null) return new { ok = false, error = "לא נמצאה תיקייה בשם: " + folder };
            }
            else { targetFolder = ns.GetDefaultFolder(Outlook.OlDefaultFolders.olFolderInbox); }
            var items = targetFolder.Items;
            items.Sort("[ReceivedTime]", true);

            bool isFiltering = unreadOnly || dateFilter != "all" || !string.IsNullOrEmpty(query);
            int scanLimit = isFiltering ? 2000 : 500;
            DateTime today = DateTime.Today;

            var mails = new List<object>();
            int scanned = 0;
            foreach (object o in items)
            {
                if (mails.Count >= count) break;
                scanned++; if (scanned > scanLimit) break;
                var mail = o as Outlook.MailItem; if (mail == null) continue;

                if (unreadOnly && !mail.UnRead) continue;

                DateTime received = DateTime.MinValue; bool hasDate = true;
                try { received = mail.ReceivedTime; } catch { hasDate = false; }
                if (dateFilter == "today" && (!hasDate || received.Date != today)) continue;
                if (dateFilter == "yesterday" && (!hasDate || received.Date != today.AddDays(-1))) continue;

                string subj = mail.Subject ?? "(ללא נושא)";
                string from = mail.SenderName ?? "";
                string bodyText = mail.Body ?? "";
                if (!string.IsNullOrEmpty(query))
                {
                    string hay = (subj + " " + from + " " + bodyText).ToLowerInvariant();
                    if (!hay.Contains(query.ToLowerInvariant())) continue;
                }
                string preview = bodyText.Replace("\r", " ").Replace("\n", " ").Trim();
                if (preview.Length > 200) preview = preview.Substring(0, 200) + "...";
                string date = hasDate ? received.ToString("dd/MM/yyyy HH:mm") : "";
                mails.Add(new { subject = subj, from = from, date = date, preview = preview, unread = mail.UnRead });
            }
            Console.WriteLine("📧 הוחזרו " + mails.Count + " מיילים.");
            return new { ok = true, mails = mails };
        }

        static object SendMail(string to, string subject, string body)
        {
            if (string.IsNullOrWhiteSpace(to)) return new { ok = false, error = "לא הוגדר נמען (to)." };
            try
            {
                var app = new Outlook.Application();
                Outlook.MailItem mail = (Outlook.MailItem)app.CreateItem(Outlook.OlItemType.olMailItem);
                mail.To = to.Trim();
                mail.Subject = subject ?? "";
                mail.Body = body ?? "";
                mail.Send();
                Console.WriteLine("✉️ נשלח מייל אל: " + to);
                return new { ok = true };
            }
            catch (Exception ex) { return new { ok = false, error = "שגיאה בשליחה: " + ex.Message }; }
        }

        static bool IsAllowed(string path)
        {
            if (AllowedDirs == null || AllowedDirs.Length == 0) return true;
            string full; try { full = Path.GetFullPath(path).TrimEnd('\\') + "\\"; } catch { return false; }
            foreach (var d in AllowedDirs) { string bd; try { bd = Path.GetFullPath(d).TrimEnd('\\') + "\\"; } catch { continue; } if (full.StartsWith(bd, StringComparison.OrdinalIgnoreCase)) return true; }
            return false;
        }
        static string Human(long b) { string[] u = { "B", "KB", "MB", "GB", "TB" }; double s = b; int i = 0; while (s >= 1024 && i < u.Length - 1) { s /= 1024; i++; } return s.ToString("0.##") + " " + u[i]; }
        static object FsAnalyze(string path, bool recursive)
        {
            if (string.IsNullOrWhiteSpace(path)) return new { ok = false, error = "נתיב ריק" };
            if (!IsAllowed(path)) return new { ok = false, error = "מחוץ לתיקיות המותרות." };
            if (!Directory.Exists(path)) return new { ok = false, error = "התיקייה לא קיימת: " + path };
            var files = Directory.GetFiles(path, "*", recursive ? SearchOption.AllDirectories : SearchOption.TopDirectoryOnly);
            long total = 0; var byExt = new Dictionary<string, long[]>();
            foreach (var f in files) { long len = 0; try { len = new FileInfo(f).Length; } catch { } total += len; string ext = Path.GetExtension(f).ToLowerInvariant(); if (ext == "") ext = "(ללא)"; if (!byExt.ContainsKey(ext)) byExt[ext] = new long[2]; byExt[ext][0]++; byExt[ext][1] += len; }
            var types = byExt.OrderByDescending(k => k.Value[1]).Select(k => new { ext = k.Key, count = k.Value[0], size = Human(k.Value[1]) }).ToList();
            return new { ok = true, total = files.Length, totalSize = Human(total), types = types };
        }
        static object FsPlan(string source, string dest, string pattern, string op)
        {
            if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(dest)) return new { ok = false, error = "חסר מקור או יעד" };
            if (!IsAllowed(source)) return new { ok = false, error = "המקור מחוץ לתיקיות המותרות." };
            if (!IsAllowed(dest)) return new { ok = false, error = "היעד מחוץ לתיקיות המותרות." };
            if (!Directory.Exists(source)) return new { ok = false, error = "תיקיית המקור לא קיימת: " + source };
            if (string.IsNullOrWhiteSpace(pattern)) pattern = "*";
            var files = Directory.GetFiles(source, pattern, SearchOption.TopDirectoryOnly);
            long size = 0; var names = new List<string>(); foreach (var f in files) { try { size += new FileInfo(f).Length; } catch { } names.Add(Path.GetFileName(f)); }
            return new { ok = true, op = (op == "move" ? "move" : "copy"), count = files.Length, size = Human(size), source = source, dest = dest, destExists = Directory.Exists(dest), sample = names.Take(20).ToList() };
        }
        static object FsExecute(string source, string dest, string pattern, string op)
        {
            if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(dest)) return new { ok = false, error = "חסר מקור או יעד" };
            if (!IsAllowed(source)) return new { ok = false, error = "המקור מחוץ לתיקיות המותרות." };
            if (!IsAllowed(dest)) return new { ok = false, error = "היעד מחוץ לתיקיות המותרות." };
            if (!Directory.Exists(source)) return new { ok = false, error = "המקור לא קיים." };
            if (string.IsNullOrWhiteSpace(pattern)) pattern = "*";
            Directory.CreateDirectory(dest); bool move = op == "move";
            var files = Directory.GetFiles(source, pattern, SearchOption.TopDirectoryOnly);
            int done = 0, skipped = 0; var errors = new List<string>();
            foreach (var f in files)
            {
                string target = Path.Combine(dest, Path.GetFileName(f));
                try { if (File.Exists(target)) { skipped++; continue; } if (move) File.Move(f, target); else File.Copy(f, target); done++; }
                catch (Exception e) { errors.Add(Path.GetFileName(f) + ": " + e.Message); }
            }
            Console.WriteLine("🗂️ " + (move ? "הועברו " : "הועתקו ") + done);
            return new { ok = true, op = (move ? "move" : "copy"), done = done, skipped = skipped, errors = errors, total = files.Length };
        }


    // מחפש חלון לפי השם המדויק שלו - בלי קשר לאיזה תהליך (process) פתח אותו
    // מחזיר רשימה של כל שמות הטאבים בקובץ - שימושי לאבחון שמות מדויקים
    static string[] GetSheetNames(string filePath)
    {
        Excel.Application excelApp = null;
        Excel.Workbook wb = null;
        try
        {
            excelApp = new Excel.Application();
            excelApp.Visible = false;
            excelApp.DisplayAlerts = false;
            wb = excelApp.Workbooks.Open(filePath, ReadOnly: true);

            var names = new System.Collections.Generic.List<string>();
            foreach (Excel.Worksheet s in wb.Sheets) names.Add(s.Name);
            return names.ToArray();
        }
        finally
        {
            if (wb != null) { wb.Close(false); Marshal.ReleaseComObject(wb); }
            if (excelApp != null) { excelApp.Quit(); Marshal.ReleaseComObject(excelApp); }
            GC.Collect();
            GC.WaitForPendingFinalizers();
        }
    }

    // פותח את הקובץ המקור, ומעתיק טאב בודד לקובץ חדש
    static void CopySingleSheetToNewWorkbook(string sourceFile, string sheetName, string outputFullPath)
    {
        Excel.Application excelApp = null;
        Excel.Workbook sourceWb = null;
        Excel.Workbook newWb = null;

        try
        {
            excelApp = new Excel.Application();
            excelApp.Visible = false;
            excelApp.DisplayAlerts = false;

            sourceWb = excelApp.Workbooks.Open(sourceFile, ReadOnly: true);
            Excel.Worksheet sheet = (Excel.Worksheet)sourceWb.Sheets[sheetName];

            newWb = excelApp.Workbooks.Add();
            Excel.Worksheet placeholderSheet = (Excel.Worksheet)newWb.Sheets[1];

            sheet.Copy(After: newWb.Sheets[newWb.Sheets.Count]);
            placeholderSheet.Delete();

            newWb.SaveAs(outputFullPath, Excel.XlFileFormat.xlOpenXMLWorkbook);
        }
        finally
        {
            if (newWb != null) { newWb.Close(false); Marshal.ReleaseComObject(newWb); }
            if (sourceWb != null) { sourceWb.Close(false); Marshal.ReleaseComObject(sourceWb); }
            if (excelApp != null) { excelApp.Quit(); Marshal.ReleaseComObject(excelApp); }
            GC.Collect();
            GC.WaitForPendingFinalizers();
        }
    }

    // מעתיק את כל התוכן (קבצים ותתי-תיקיות) מתיקיית מקור לתיקיית יעד
    static void CopyDirectoryContents(string sourceDir, string destDir)
    {
        Directory.CreateDirectory(destDir);

        foreach (string file in Directory.GetFiles(sourceDir))
        {
            string destFile = Path.Combine(destDir, Path.GetFileName(file));
            File.Copy(file, destFile, true);
        }

        foreach (string subDir in Directory.GetDirectories(sourceDir))
        {
            string destSubDir = Path.Combine(destDir, Path.GetFileName(subDir));
            CopyDirectoryContents(subDir, destSubDir);
        }
    }

    // פותח את הקובץ המקור, ומעתיק שני טאבים שלמים לקובץ חדש (כל אחד כטאב נפרד)
    static void CombineTabsToNewWorkbook(string sourceFile, string sheet1Name, string sheet2Name, string outputFullPath)
    {
        Excel.Application excelApp = null;
        Excel.Workbook sourceWb = null;
        Excel.Workbook newWb = null;

        try
        {
            excelApp = new Excel.Application();
            excelApp.Visible = false;
            excelApp.DisplayAlerts = false;

            sourceWb = excelApp.Workbooks.Open(sourceFile, ReadOnly: true);

            Excel.Worksheet sheet1 = (Excel.Worksheet)sourceWb.Sheets[sheet1Name];
            Excel.Worksheet sheet2 = (Excel.Worksheet)sourceWb.Sheets[sheet2Name];

            // חוברת חדשה - מתחילה עם טאב ברירת מחדל אחד ריק
            newWb = excelApp.Workbooks.Add();
            Excel.Worksheet placeholderSheet = (Excel.Worksheet)newWb.Sheets[1];

            // מעתיקים את שני הטאבים בשלמותם (עם כל התוכן והעיצוב) לתוך החוברת החדשה
            sheet1.Copy(After: newWb.Sheets[newWb.Sheets.Count]);
            sheet2.Copy(After: newWb.Sheets[newWb.Sheets.Count]);

            // מוחקים את הטאב הריק המקורי שנוצר אוטומטית עם החוברת החדשה
            placeholderSheet.Delete();

            newWb.SaveAs(outputFullPath, Excel.XlFileFormat.xlOpenXMLWorkbook);
        }
        finally
        {
            // חשוב מאוד: לשחרר הכל כמו שצריך, אחרת נשארים תהליכי Excel "רוחות רפאים"
            if (newWb != null) { newWb.Close(false); Marshal.ReleaseComObject(newWb); }
            if (sourceWb != null) { sourceWb.Close(false); Marshal.ReleaseComObject(sourceWb); }
            if (excelApp != null) { excelApp.Quit(); Marshal.ReleaseComObject(excelApp); }
            GC.Collect();
            GC.WaitForPendingFinalizers();
        }
    }

    static AutomationElement FindWindowByTitleAnyProcess(AutomationElement innerSearchRoot, string title, int timeoutSeconds)
    {
        for (int i = 0; i < timeoutSeconds * 2; i++)
        {
            AutomationElement top = AutomationElement.RootElement.FindFirst(TreeScope.Children,
                new PropertyCondition(AutomationElement.NameProperty, title));
            if (top != null) return top;

            if (innerSearchRoot != null)
            {
                AutomationElement inner = innerSearchRoot.FindFirst(TreeScope.Descendants,
                    new PropertyCondition(AutomationElement.NameProperty, title));
                if (inner != null) return inner;
            }
            Thread.Sleep(500);
        }
        return null;
    }

    static HashSet<IntPtr> GetWindowHandlesForProcess(int pid)
    {
        var set = new HashSet<IntPtr>();
        AutomationElementCollection windows = AutomationElement.RootElement.FindAll(TreeScope.Children, Condition.TrueCondition);
        foreach (AutomationElement win in windows)
        {
            int wpid = 0;
            try { wpid = win.Current.ProcessId; } catch { continue; }
            if (wpid != pid) continue;
            try { set.Add(new IntPtr(win.Current.NativeWindowHandle)); } catch { }
        }
        return set;
    }

    static AutomationElement FindNewWindowByHandle(int pid, HashSet<IntPtr> knownHandles, int timeoutSeconds)
    {
        for (int i = 0; i < timeoutSeconds * 2; i++)
        {
            AutomationElementCollection windows = AutomationElement.RootElement.FindAll(TreeScope.Children, Condition.TrueCondition);
            foreach (AutomationElement win in windows)
            {
                int wpid = 0;
                try { wpid = win.Current.ProcessId; } catch { continue; }
                if (wpid != pid) continue;
                IntPtr h;
                try { h = new IntPtr(win.Current.NativeWindowHandle); } catch { continue; }
                if (!knownHandles.Contains(h)) return win;
            }
            Thread.Sleep(500);
        }
        return null;
    }

    // מחפש כל חלון (בכל תהליך) עם כפתור "אישור" או "OK", ולוחץ עליו
    static void HandleConfirmationPopup(int timeoutSeconds)
    {
        for (int i = 0; i < timeoutSeconds * 2; i++)
        {
            AutomationElementCollection windows = AutomationElement.RootElement.FindAll(TreeScope.Children, Condition.TrueCondition);
            foreach (AutomationElement w in windows)
            {
                AutomationElement okBtn = null;
                try
                {
                    Condition cond = new OrCondition(
                        new PropertyCondition(AutomationElement.NameProperty, "אישור"),
                        new PropertyCondition(AutomationElement.NameProperty, "OK"),
                        new PropertyCondition(AutomationElement.NameProperty, "כן"),
                        new PropertyCondition(AutomationElement.NameProperty, "Yes"));
                    okBtn = w.FindFirst(TreeScope.Descendants, cond);
                }
                catch { }

                if (okBtn != null)
                {
                    Console.WriteLine("   נמצא חלון: '" + w.Current.Name + "' - לוחץ על אישור...");
                    object pattern;
                    bool clicked = false;
                    if (okBtn.TryGetCurrentPattern(InvokePattern.Pattern, out pattern))
                    {
                        try { ((InvokePattern)pattern).Invoke(); clicked = true; } catch { }
                    }
                    if (!clicked) RealClick(okBtn);
                    return;
                }
            }
            Thread.Sleep(500);
        }
        Console.WriteLine("   (לא הופיע חלון אישור - אולי לא היה צורך הפעם)");
    }

    static void RealClick(AutomationElement element)
    {
        var rect = element.Current.BoundingRectangle;
        int x = (int)(rect.Left + rect.Width / 2);
        int y = (int)(rect.Top + rect.Height / 2);
        SetCursorPos(x, y);
        Thread.Sleep(150);
        mouse_event(MOUSEEVENTF_LEFTDOWN, 0, 0, 0, UIntPtr.Zero);
        Thread.Sleep(80);
        mouse_event(MOUSEEVENTF_LEFTUP, 0, 0, 0, UIntPtr.Zero);
    }

    static void BringToFront(AutomationElement window)
    {
        try
        {
            IntPtr hWnd = new IntPtr(window.Current.NativeWindowHandle);
            SetForegroundWindow(hWnd);
        }
        catch { }
    }

    [DllImport("user32.dll")]
    static extern void keybd_event(byte bVk, byte bScan, uint dwFlags, UIntPtr dwExtraInfo);

    const byte VK_RETURN = 0x0D;
    const uint KEYEVENTF_KEYUP = 0x0002;

    static void PressEnter()
    {
        keybd_event(VK_RETURN, 0, 0, UIntPtr.Zero);

        static IXLWorksheet GetOrCreateWorksheet(XLWorkbook wb, string sheetName)
        {
            if (!string.IsNullOrWhiteSpace(sheetName))
            {
                if (wb.Worksheets.Contains(sheetName)) return wb.Worksheet(sheetName);
                return wb.Worksheets.Add(sheetName);
            }
            return wb.Worksheets.FirstOrDefault() ?? wb.Worksheets.Add("Sheet1");
        }

        static object ExcelPlan(ExcelReq req)
        {
            string path = req.path, action = req.action, column = req.column, maxLengthStr = req.maxLength;
            var rows = req.rows;
            if (string.IsNullOrWhiteSpace(path)) return new { ok = false, error = "חסר נתיב לקובץ" };
            if (!IsAllowed(path)) return new { ok = false, error = "הנתיב מחוץ לתיקיות המותרות." };
            bool exists = false; try { exists = File.Exists(path); } catch { }
            var needsExisting = new[] { "rtl", "setCell", "deleteRow", "deleteColumn", "truncateColumn", "format", "columnWidth", "freezeHeader", "addSheet", "compute", "sort", "findDuplicates", "columnStats" };
            if (needsExisting.Contains(action) && !exists)
                return new { ok = false, error = "הקובץ לא קיים — צריך ליצור אותו קודם." };
            int rowCount = rows != null ? rows.Count : 0;
            var validActions = new[] { "append", "rtl", "setCell", "deleteRow", "deleteColumn", "truncateColumn", "format", "columnWidth", "freezeHeader", "addSheet", "compute", "sort", "findDuplicates", "columnStats" };
            string act = validActions.Contains(action) ? action : "create";

            try
            {
                if (act == "truncateColumn")
                {
                    int maxLen; if (!int.TryParse(maxLengthStr, out maxLen) || maxLen < 1) return new { ok = false, error = "מספר תווים מקסימלי לא תקין." };
                    int targetLen; if (!int.TryParse(req.targetLength, out targetLen) || targetLen < 1) targetLen = maxLen;
                    int affected = 0;
                    using (var wb = new XLWorkbook(path)) { var ws = GetOrCreateWorksheet(wb, req.sheet); foreach (var c in ws.Column(column).CellsUsed()) if (c.GetString().Length > maxLen) affected++; }
                    return new { ok = true, action = act, path = path, column = column, maxLength = maxLen, targetLength = targetLen, affected = affected };
                }
                if (act == "format")
                {
                    if (string.IsNullOrWhiteSpace(req.range)) return new { ok = false, error = "לא צוין טווח." };
                    return new { ok = true, action = act, path = path, range = req.range, bold = req.bold, color = req.color };
                }
                if (act == "columnWidth")
                {
                    double w; if (!double.TryParse(req.width, out w) || w <= 0) return new { ok = false, error = "רוחב לא תקין." };
                    return new { ok = true, action = act, path = path, column = column, width = w };
                }
                if (act == "freezeHeader") return new { ok = true, action = act, path = path };
                if (act == "addSheet")
                {
                    if (string.IsNullOrWhiteSpace(req.sheet)) return new { ok = false, error = "לא צוין שם גיליון." };
                    bool sheetExists = false; using (var wb = new XLWorkbook(path)) sheetExists = wb.Worksheets.Contains(req.sheet);
                    return new { ok = true, action = act, path = path, sheet = req.sheet, sheetExists = sheetExists };
                }
                if (act == "compute")
                {
                    string opv = (req.op ?? "sum").ToLowerInvariant();
                    double result = 0; int countNum = 0;
                    using (var wb = new XLWorkbook(path))
                    {
                        var ws = GetOrCreateWorksheet(wb, req.sheet);
                        var vals = new List<double>();
                        foreach (var c in ws.Column(column).CellsUsed()) { double dv; if (double.TryParse(c.GetString(), out dv)) vals.Add(dv); }
                        countNum = vals.Count;
                        if (opv == "sum") result = vals.Sum();
                        else if (opv == "average") result = vals.Count > 0 ? vals.Average() : 0;
                        else if (opv == "max") result = vals.Count > 0 ? vals.Max() : 0;
                        else if (opv == "min") result = vals.Count > 0 ? vals.Min() : 0;
                        else if (opv == "count") result = countNum;
                    }
                    return new { ok = true, action = act, path = path, column = column, op = opv, result = result, countNum = countNum };
                }
                if (act == "sort")
                {
                    return new { ok = true, action = act, path = path, column = column, order = (req.order == "desc" ? "desc" : "asc") };
                }
                if (act == "findDuplicates")
                {
                    var counts = new Dictionary<string, int>();
                    using (var wb = new XLWorkbook(path))
                    {
                        var ws = GetOrCreateWorksheet(wb, req.sheet);
                        foreach (var c in ws.Column(column).CellsUsed())
                        {
                            string s = c.GetString();
                            if (string.IsNullOrWhiteSpace(s)) continue;
                            if (!counts.ContainsKey(s)) counts[s] = 0;
                            counts[s]++;
                        }
                    }
                    var dups = counts.Where(kv => kv.Value > 1).Select(kv => new { value = kv.Key, count = kv.Value }).ToList();
                    return new { ok = true, action = act, path = path, column = column, duplicates = dups };
                }
                if (act == "columnStats")
                {
                    var stats = new List<object>();
                    using (var wb = new XLWorkbook(path))
                    {
                        var ws = GetOrCreateWorksheet(wb, req.sheet);
                        var used = ws.RangeUsed();
                        if (used != null)
                        {
                            int firstCol = used.FirstColumn().ColumnNumber();
                            int lastCol = used.LastColumn().ColumnNumber();
                            for (int c = firstCol; c <= lastCol; c++)
                            {
                                long total = 0; int maxLen = 0;
                                foreach (var cellUsed in ws.Column(c).CellsUsed())
                                {
                                    int len = cellUsed.GetString().Length;
                                    total += len;
                                    if (len > maxLen) maxLen = len;
                                }
                                string colLetter = XLHelper.GetColumnLetterFromNumber(c);
                                stats.Add(new { column = colLetter, totalChars = total, maxCellChars = maxLen });
                            }
                        }
                    }
                    return new { ok = true, action = act, path = path, stats = stats };
                }
            }
            catch (Exception ex) { return new { ok = false, error = "שגיאת אקסל: " + ex.Message }; }

            return new { ok = true, action = act, path = path, exists = exists, rowCount = rowCount, cell = req.cell, value = req.value, row = req.row, column = column };
        }

        static object ExcelExecute(ExcelReq req)
        {
            string path = req.path, action = req.action, column = req.column, maxLengthStr = req.maxLength;
            string cell = req.cell, value = req.value, rowNum = req.row;
            var rows = req.rows;
            if (string.IsNullOrWhiteSpace(path)) return new { ok = false, error = "חסר נתיב לקובץ" };
            if (!IsAllowed(path)) return new { ok = false, error = "הנתיב מחוץ לתיקיות המותרות." };
            try
            {
                string dir = Path.GetDirectoryName(path);
                if (!string.IsNullOrWhiteSpace(dir)) Directory.CreateDirectory(dir);

                if (action == "truncateColumn")
                {
                    if (!File.Exists(path)) return new { ok = false, error = "הקובץ לא קיים." };
                    int maxLen; if (!int.TryParse(maxLengthStr, out maxLen) || maxLen < 1) return new { ok = false, error = "מספר תווים מקסימלי לא תקין." };
                    int targetLen; if (!int.TryParse(req.targetLength, out targetLen) || targetLen < 1) targetLen = maxLen;
                    int changed = 0;
                    using (var wb = new XLWorkbook(path))
                    {
                        var ws2 = GetOrCreateWorksheet(wb, req.sheet);
                        foreach (var c in ws2.Column(column).CellsUsed()) { string s = c.GetString(); if (s.Length > maxLen) { c.Value = s.Substring(0, targetLen); changed++; } }
                        wb.Save();
                    }
                    Console.WriteLine("📊 קוצרו " + changed + " תאים בעמודה " + column + " (סף " + maxLen + ", יעד " + targetLen + " תווים): " + path);
                    return new { ok = true, action = "truncateColumn", path = path, column = column, changed = changed };

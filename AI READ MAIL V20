                                SendAutoMail(senderEmail, "בוצע: הקובץ עבור מספר " + number + " הועתק", "הקובץ הועתק לתיקייה שביקשת: " + destPath);
                                Console.WriteLine("📎 הועתק קובץ '" + Path.GetFileName(filePath) + "' אל " + destPath + " (ביקש: " + senderEmail + ").");
                            }
                            else { SendAutoMail(senderEmail, "הקובץ כבר קיים ביעד", "קובץ בשם זה כבר קיים בתיקייה " + destPath + " — לא הוחלף."); }
                        }
                        catch (Exception ex) { Console.WriteLine("⚠️ שגיאה בהעתקה אל " + destPath + ": " + ex.Message); }

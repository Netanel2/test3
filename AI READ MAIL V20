function pickFile(){fi.click();}
function toggleLearn(){learnMode=!learnMode;document.getElementById('learnBtn').classList.toggle('on',learnMode);document.getElementById('banner').classList.toggle('show',learnMode);q.placeholder=learnMode?'שגיאה + פתרון...':'שאל, בקש קבצים, או: תראה מיילים אחרונים / חפש מייל מ...';}
function render(bubble,text){
if(window.marked){bubble.innerHTML=marked.parse(text);
bubble.querySelectorAll('pre code').forEach(function(block){
if(window.hljs){try{hljs.highlightElement(block);}catch(e){}}
var pre=block.parentElement;var wrap=document.createElement('div');wrap.className='codewrap';pre.parentNode.insertBefore(wrap,pre);wrap.appendChild(pre);
var btn=document.createElement('button');btn.className='copybtn';btn.textContent='העתק';
btn.onclick=function(){var txt=block.textContent;if(navigator.clipboard){navigator.clipboard.writeText(txt);}else{var ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);}btn.textContent='הועתק';setTimeout(function(){btn.textContent='העתק';},1500);};
wrap.appendChild(btn);});}else{bubble.textContent=text;}}
function add(who,text,cls){var w=document.getElementById('chat');var d=document.createElement('div');d.className='msg '+(cls||'');
var wd=document.createElement('div');wd.className='who';wd.textContent=who;var b=document.createElement('div');b.className='bubble';b.textContent=text;
d.appendChild(wd);d.appendChild(b);w.appendChild(d);document.querySelector('main').scrollTop=1e9;return d;}
q.addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send();}});

async function send(){var t=q.value.trim();if(!t)return;q.value='';
if(learnMode){add('לימוד',t,'me');var dl=add('מערכת','שומר...','learn');
try{var r=await fetch('/api/learn',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:t})});var j=await r.json();
if(j.ok){dl.querySelector('.bubble').textContent='נלמד ונשמר ✓';stats();}else{dl.querySelector('.bubble').textContent='שגיאה: '+(j.error||'נכשל');}}catch(e){dl.querySelector('.bubble').textContent='שגיאה: '+e.message;}return;}
add('אתה',t,'me');var d=add('עוזר','חושב...');
try{var ir=await fetch('/api/intent',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})});var ij=await ir.json();
if(ij&&ij.kind==='file'){showFileConfirm(d,ij);return;}
if(ij&&ij.kind==='mail'){showMail(d,ij);return;}
if(ij&&ij.kind==='sendmail'){showSendConfirm(d,ij);return;}
}catch(e){}
try{var r=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question:t})});var j=await r.json();
if(j.answer){render(d.querySelector('.bubble'),j.answer);}else{d.querySelector('.bubble').textContent=j.error||'אין תשובה';}
if(j.sources&&j.sources.length){var s=document.createElement('div');s.className='src';s.textContent='📄 '+j.sources.join(' | ');d.appendChild(s);}
}catch(e){d.querySelector('.bubble').textContent='שגיאה: '+e.message;}}

async function showMail(d,intent){var b=d.querySelector('.bubble');b.textContent='קורא מ-Outlook...';
try{var r=await fetch('/api/mail/read',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(intent)});var j=await r.json();
if(!j.ok){b.textContent='⚠️ '+j.error;return;}
if(!j.mails||!j.mails.length){b.textContent='לא נמצאו מיילים.';return;}
b.textContent=(intent.query?('תוצאות עבור: '+intent.query):'המיילים האחרונים')+' ('+j.mails.length+'):';
j.mails.forEach(function(m){
var el=document.createElement('div');el.className='mail';
var h=document.createElement('div');h.className='mh';h.textContent=m.subject;
var meta=document.createElement('div');meta.className='mm';meta.textContent='מאת: '+m.from+' · '+m.date+(m.unread?' · לא נקרא':'');
var pv=document.createElement('div');pv.className='mp';pv.textContent=m.preview;
el.appendChild(h);el.appendChild(meta);el.appendChild(pv);b.appendChild(el);});
}catch(e){b.textContent='שגיאה: '+e.message;}}

async function showFileConfirm(d,intent){var b=d.querySelector('.bubble');
var plan;try{var r=await fetch('/api/fs/plan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(intent)});plan=await r.json();}catch(e){b.textContent='שגיאה: '+e.message;return;}
if(!plan.ok){b.textContent='⚠️ '+plan.error;return;}
var opText=plan.op==='move'?'להעביר (מוחק מהמקור)':'להעתיק';
b.textContent='';
var box=document.createElement('div');box.className='confirm';
box.textContent='הבנתי שאתה רוצה '+opText+' '+plan.count+' קבצים ('+plan.size+'):';
var l1=document.createElement('div');l1.textContent='מ: '+plan.source;
var l2=document.createElement('div');l2.textContent='אל: '+plan.dest+(plan.destExists?'':' (ייווצר)');
box.appendChild(l1);box.appendChild(l2);
if(plan.sample&&plan.sample.length){var s=document.createElement('div');s.style.fontSize='12px';s.style.color='#8b93a4';s.style.marginTop='6px';s.textContent='דוגמאות: '+plan.sample.join(', ')+(plan.count>20?' ...':'');box.appendChild(s);}
b.appendChild(box);
if(plan.count>0){var btns=document.createElement('div');btns.className='cbtns';
var go=document.createElement('button');go.className='go';go.textContent='▶ בצע';
var no=document.createElement('button');no.className='no';no.textContent='ביטול';
go.onclick=async function(){go.disabled=true;no.disabled=true;go.textContent='מבצע...';
try{var r=await fetch('/api/fs/execute',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(intent)});var j=await r.json();
btns.textContent=j.ok?('✓ בוצע: '+j.done+' · דולגו: '+j.skipped+' · מתוך '+j.total):('⚠️ '+j.error);
}catch(e){btns.textContent='שגיאה: '+e.message;}};
no.onclick=function(){btns.textContent='בוטל.';};
btns.appendChild(go);btns.appendChild(no);b.appendChild(btns);}
else{var nf=document.createElement('div');nf.style.color='#8b93a4';nf.style.marginTop='6px';nf.textContent='לא נמצאו קבצים.';b.appendChild(nf);}}

async function showSendConfirm(d,intent){var b=d.querySelector('.bubble');b.textContent='';
var box=document.createElement('div');box.className='confirm';
box.textContent='הבנתי שאתה רוצה לשלוח מייל:';
var l1=document.createElement('div');l1.style.marginTop='6px';l1.innerHTML='<b>אל:</b> '+(intent.to||'<span style=color:#e08a8a>לא צוין נמען — ערוך למטה</span>');
var l2=document.createElement('div');l2.style.marginTop='4px';l2.innerHTML='<b>נושא:</b> '+(intent.subject||'(ללא נושא)');
var l3=document.createElement('div');l3.style.marginTop='4px';l3.innerHTML='<b>תוכן:</b>';
var bodyBox=document.createElement('textarea');bodyBox.value=intent.body||'';bodyBox.rows=5;bodyBox.style.width='100%';bodyBox.style.marginTop='4px';bodyBox.style.background='#0d0f14';bodyBox.style.color='#e7ecf3';bodyBox.style.border='1px solid #2b3340';bodyBox.style.borderRadius='8px';bodyBox.style.padding='8px';bodyBox.style.fontFamily='inherit';
var toBox=document.createElement('input');toBox.value=intent.to||'';toBox.placeholder='כתובת נמען';toBox.style.width='100%';toBox.style.marginTop='4px';toBox.style.background='#0d0f14';toBox.style.color='#e7ecf3';toBox.style.border='1px solid #2b3340';toBox.style.borderRadius='8px';toBox.style.padding='8px';toBox.style.fontFamily='inherit';toBox.style.direction='ltr';
box.appendChild(l1);box.appendChild(toBox);box.appendChild(l2);box.appendChild(l3);box.appendChild(bodyBox);
b.appendChild(box);
var btns=document.createElement('div');btns.className='cbtns';
var go=document.createElement('button');go.className='go';go.textContent='✉️ שלח';
var no=document.createElement('button');no.className='no';no.textContent='ביטול';
go.onclick=async function(){go.disabled=true;no.disabled=true;go.textContent='שולח...';
try{var r=await fetch('/api/mail/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({to:toBox.value,subject:intent.subject,body:bodyBox.value})});var j=await r.json();
btns.textContent=j.ok?'✓ נשלח בהצלחה':('⚠️ '+j.error);
}catch(e){btns.textContent='שגיאה: '+e.message;}};
no.onclick=function(){btns.textContent='בוטל.';};
btns.appendChild(go);btns.appendChild(no);b.appendChild(btns);}

fi.addEventListener('change',function(){handle(fi.files);fi.value='';});
var dc=0;window.addEventListener('dragenter',function(e){e.preventDefault();dc++;drop.classList.add('show');});
window.addEventListener('dragover',function(e){e.preventDefault();});window.addEventListener('dragleave',function(e){e.preventDefault();dc--;if(dc<=0)drop.classList.remove('show');});

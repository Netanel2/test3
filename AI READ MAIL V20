תזכורת מהירה מה לעשות איתו:

תוריד את הקובץ למעלה
פתח את הפרויקט ב-Visual Studio 2019 (Console App .NET Framework)
תעתיק את התוכן שלו לתוך Program.cs בפרויקט (מחליף את מה שכבר יש שם)
שנה את השורה הזו לנתיב האמיתי של הקובץ אצלך:
   string exePath = @"C:\Users\YourUserName\Desktop\מנוע דוחות.exe";
הוסף את שני ה-References (קליק ימני על References ← Add Reference ← Assemblies): UIAutomationClient ו-UIAutomationTypes
לחץ F5 להריץ

אחרי שזה ירוץ, תיפתח לך התוכנה "מנוע דוחות" וגם חלון שחור עם רשימת שמות - את זה תעתיק ותשלח לי, ולפיו אכתוב את הקוד הסופי שבאמת בוחר את הקטגוריה ולוחץ על הכפתורים.


using System;
using System.Diagnostics;
using System.Threading;
using System.Windows.Automation;

class Program
{
    static void Main()
    {
        // *** שנה כאן לנתיב האמיתי של הקובץ מנוע דוחות.exe אצלך ***
        string exePath = @"C:\Users\YourUserName\Desktop\מנוע דוחות.exe";

        Console.WriteLine("פותח את התוכנה...");
        Process proc = Process.Start(exePath);
        proc.WaitForInputIdle();

        // נותנים לחלון זמן להיפתח לגמרי
        Thread.Sleep(2000);

        // מחפשים את החלון הראשי של התוכנה שפתחנו
        AutomationElement mainWindow = null;
        for (int i = 0; i < 20 && mainWindow == null; i++)
        {
            mainWindow = AutomationElement.RootElement.FindFirst(
                TreeScope.Children,
                new PropertyCondition(AutomationElement.ProcessIdProperty, proc.Id));

            if (mainWindow == null)
                Thread.Sleep(500);
        }

        if (mainWindow == null)
        {
            Console.WriteLine("לא הצלחתי למצוא את חלון התוכנה. אולי צריך יותר זמן המתנה, או שנפתח חלון ביניים לפני החלון הראשי.");
            Console.WriteLine("לחץ Enter לסיום...");
            Console.ReadLine();
            return;
        }

        Console.WriteLine("נמצא חלון: " + mainWindow.Current.Name);
        Console.WriteLine("מחפש את כל הכפתורים והתפריטים בתוכו...");
        Console.WriteLine(new string('-', 60));

        // עוברים על כל האלמנטים (כפתורים, תפריטים, רשימות) שבתוך החלון
        AutomationElementCollection allControls = mainWindow.FindAll(
            TreeScope.Descendants, Condition.TrueCondition);

        foreach (AutomationElement el in allControls)
        {
            string type = el.Current.ControlType.ProgrammaticName;
            string name = el.Current.Name;
            string autoId = el.Current.AutomationId;

            // מדפיסים רק אלמנטים עם שם, כדי שלא יהיה יותר מדי רעש
            if (!string.IsNullOrWhiteSpace(name) || !string.IsNullOrWhiteSpace(autoId))
            {
                Console.WriteLine($"סוג: {type}   |   שם: '{name}'   |   מזהה: '{autoId}'");
            }
        }

        Console.WriteLine(new string('-', 60));
        Console.WriteLine("סיימתי. אפשר להעתיק את כל הטקסט למעלה ולשלוח אליי.");
        Console.WriteLine("לחץ Enter לסגירה (זה לא יסגור את התוכנה עצמה)...");
        Console.ReadLine();
    }
}

                    try
                    {
                        Directory.CreateDirectory(destPath);
                        var topFiles = Directory.GetFiles(folder);
                        int copied = 0, skipped = 0; var copyErrors = new List<string>();
                        if (topFiles.Length == 0 && Directory.GetDirectories(folder).Length > 0)
                        {
                            // אין קבצים ישירות אבל יש תת-תיקיות — מעתיקים את כל העץ עם המבנה שלו
                            int totalCount = 0; try { totalCount = Directory.GetFiles(folder, "*", SearchOption.AllDirectories).Length; } catch { }
                            lock (FsProgressLock) { FsProgressDone = 0; FsProgressTotal = totalCount; FsProgressCurrentFile = ""; }
                            CopyDirectoryRecursive(folder, destPath, false, ref copied, ref skipped, copyErrors);
                            lock (FsProgressLock) { FsProgressDone = totalCount; FsProgressCurrentFile = ""; }
                        }
                        else
                        {
                            lock (FsProgressLock) { FsProgressDone = 0; FsProgressTotal = topFiles.Length; FsProgressCurrentFile = ""; }
                            for (int fi = 0; fi < topFiles.Length; fi++)
                            {
                                var f = topFiles[fi];
                                string target = Path.Combine(destPath, Path.GetFileName(f));
                                lock (FsProgressLock) { FsProgressCurrentFile = Path.GetFileName(f); }
                                if (File.Exists(target)) { skipped++; }
                                else { File.Copy(f, target); copied++; }
                                lock (FsProgressLock) { FsProgressDone = fi + 1; }
                                if (topFiles.Length > 20 && (fi + 1) % 10 == 0) Console.WriteLine("📎 התקדמות העתקה: " + (fi + 1) + "/" + topFiles.Length + " (" + Math.Round(100.0 * (fi + 1) / topFiles.Length) + "%)");
                            }

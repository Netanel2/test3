    // מחפש בתוך תיקייה נתונה תת-תיקייה שנוצרה/עודכנה היום
    static string FindTodayFolder(string parentFolder)
    {
        try
        {
            var dirs = Directory.GetDirectories(parentFolder);
            var todayDirs = dirs
                .Select(d => new DirectoryInfo(d))
                .Where(d => d.LastWriteTime.Date == DateTime.Today || d.CreationTime.Date == DateTime.Today)
                .OrderByDescending(d => d.LastWriteTime)
                .ToList();

            return todayDirs.FirstOrDefault()?.FullName;
        }
        catch (Exception ex)
        {
            Console.WriteLine("(!) שגיאה בגישה לתיקייה: " + ex.Message);
            return null;
        }
    }

    static AutomationElement FindWindowByProcessId(int pid, int timeoutSeconds)
    {
        for (int i = 0; i < timeoutSeconds * 2; i++)
        {
            AutomationElementCollection windows = AutomationElement.RootElement.FindAll(TreeScope.Children, Condition.TrueCondition);
            foreach (AutomationElement win in windows)
            {
                int wpid = 0;
                try { wpid = win.Current.ProcessId; } catch { continue; }
                if (wpid == pid) return win;
            }
            Thread.Sleep(500);
        }
        return null;
    }

    // מחפש חלון חדש מאותו תהליך, ששמו שונה מהחלון שכבר היה פתוח
    static AutomationElement FindNewWindow(int pid, string oldWindowName, int timeoutSeconds)
    {
        for (int i = 0; i < timeoutSeconds * 2; i++)
        {
            AutomationElementCollection windows = AutomationElement.RootElement.FindAll(TreeScope.Children, Condition.TrueCondition);
            foreach (AutomationElement win in windows)
            {
                int wpid = 0;
                try { wpid = win.Current.ProcessId; } catch { continue; }

                string name = win.Current.Name;
                if (wpid == pid && !string.IsNullOrWhiteSpace(name) && name != oldWindowName)
                    return win;
            }
            Thread.Sleep(500);
        }
        return null;
    }

    static void SelectItemInside(AutomationElement parentWindow, string containerAutomationId, string itemName)
    {
        AutomationElement container = parentWindow.FindFirst(TreeScope.Descendants,
            new PropertyCondition(AutomationElement.AutomationIdProperty, containerAutomationId));
        if (container == null) { Console.WriteLine("   (!) לא נמצא: " + containerAutomationId); return; }

        AutomationElement item = null;
        for (int i = 0; i < 10 && item == null; i++)
        {
            item = container.FindFirst(TreeScope.Descendants, new PropertyCondition(AutomationElement.NameProperty, itemName));
            if (item == null) Thread.Sleep(300);
        }
        if (item == null) { Console.WriteLine("   (!) לא נמצא פריט בשם: " + itemName); return; }

        object pattern;
        if (item.TryGetCurrentPattern(SelectionItemPattern.Pattern, out pattern))
            ((SelectionItemPattern)pattern).Select();
        else if (item.TryGetCurrentPattern(InvokePattern.Pattern, out pattern))
            ((InvokePattern)pattern).Invoke();
    }

    static void ClickButton(AutomationElement parentWindow, string buttonAutomationId)
    {
        AutomationElement button = parentWindow.FindFirst(TreeScope.Descendants,
            new PropertyCondition(AutomationElement.AutomationIdProperty, buttonAutomationId));
        if (button == null) { Console.WriteLine("   (!) לא נמצא כפתור: " + buttonAutomationId); return; }

        object pattern;
        if (button.TryGetCurrentPattern(InvokePattern.Pattern, out pattern))
            ((InvokePattern)pattern).Invoke();
    }

    static void SetTextValue(AutomationElement parentWindow, string automationId, string text)
    {
        AutomationElement field = parentWindow.FindFirst(TreeScope.Descendants,
            new PropertyCondition(AutomationElement.AutomationIdProperty, automationId));
        if (field == null) { Console.WriteLine("   (!) לא נמצא שדה: " + automationId); return; }

        object pattern;
        if (field.TryGetCurrentPattern(ValuePattern.Pattern, out pattern))
        {
            ((ValuePattern)pattern).SetValue(text);
        }
        else
        {
            Console.WriteLine("   (!) השדה '" + automationId + "' לא תומך במילוי ישיר - נצטרך גישה אחרת.");
        }
    }

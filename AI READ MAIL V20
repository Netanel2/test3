        static async Task<List<Chunk>> Ingest()
        {
            var exts = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".txt", ".md", ".docx", ".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif" };
            var files = Directory.Exists(GuidesDir) ? Directory.GetFiles(GuidesDir, "*.*", SearchOption.AllDirectories).Where(f => exts.Contains(Path.GetExtension(f))).OrderBy(f => f).ToList() : new List<string>();
            if (files.Count == 0) return new List<Chunk>();
            var sections = new List<Section>(); int n = 0;
            foreach (var f in files) { n++; Console.WriteLine("[" + n + "/" + files.Count + "] " + Path.GetFileName(f)); try { sections.AddRange(await Extract(f)); } catch (Exception e) { Console.WriteLine("   שגיאה: " + e.Message); } }
            var chunks = Chunkify(sections); if (chunks.Count == 0) return new List<Chunk>();
            Console.WriteLine("מחשב embeddings ל-" + chunks.Count + "...");
            var vecs = await EmbedBatch(chunks.Select(c => c.Text).ToList()); for (int i = 0; i < chunks.Count; i++) chunks[i].Embedding = vecs[i];
            File.WriteAllText(IndexPath, js.Serialize(chunks), new UTF8Encoding(false)); Console.WriteLine("✅ נשמר (" + chunks.Count + ")"); return chunks;
        }
        static async Task<List<Section>> Extract(string path)
        {
            string ext = Path.GetExtension(path).ToLowerInvariant(); string name = Path.GetFileName(path); var res = new List<Section>();
            if (ext == ".txt" || ext == ".md") res.Add(new Section { Source = name, Text = File.ReadAllText(path, Encoding.UTF8) });
            else if (ext == ".docx") res.AddRange(await FromDocx(path, name));
            else { byte[] bytes = File.ReadAllBytes(path); res.Add(new Section { Source = name, Text = await DescribeImage(bytes, MimeFor(ext), VisionPrompt + "\nהקשר: " + name) }); }
            return res;
        }
        static async Task<List<Section>> FromDocx(string path, string name)
        {
            var res = new List<Section>();
            using (var zip = ZipFile.OpenRead(path))
            {
                var doc = zip.GetEntry("word/document.xml");
                if (doc != null) using (var s = doc.Open())
                    {
                        var sb = new StringBuilder(); using (var r = XmlReader.Create(s, new XmlReaderSettings { IgnoreWhitespace = false }))
                            while (r.Read()) if (r.NodeType == XmlNodeType.Element) { if (r.LocalName == "t") sb.Append(r.ReadElementContentAsString()); else if (r.LocalName == "p" || r.LocalName == "br") sb.Append('\n'); }
                        if (sb.ToString().Trim().Length > 0) res.Add(new Section { Source = name, Text = sb.ToString().Trim() });
                    }
                int idx = 0;
                foreach (var e in zip.Entries)
                {
                    if (!e.FullName.StartsWith("word/media/", StringComparison.OrdinalIgnoreCase)) continue;
                    string mext = Path.GetExtension(e.Name).ToLowerInvariant(); if (mext != ".png" && mext != ".jpg" && mext != ".jpeg" && mext != ".gif" && mext != ".bmp") continue;
                    idx++; byte[] bytes; using (var es = e.Open()) using (var ms = new MemoryStream()) { es.CopyTo(ms); bytes = ms.ToArray(); }
                    res.Add(new Section { Source = name, Text = "[צילום מסך " + idx + "]\n" + await DescribeImage(bytes, MimeFor(mext), VisionPrompt + "\nהקשר: " + name + " תמונה " + idx) });
                }
            }
            return res;
        }
        static List<Chunk> Chunkify(List<Section> secs)
        {
            var outp = new List<Chunk>();
            foreach (var s in secs)
            {
                string t = (s.Text ?? "").Trim(); if (t.Length == 0) continue; int start = 0;
                while (start < t.Length) { int len = Math.Min(1500, t.Length - start); outp.Add(new Chunk { Source = s.Source, Text = t.Substring(start, len).Trim() }); if (start + 1500 >= t.Length) break; start += 1250; }
            }
            return outp;
        }
        static async Task<Dictionary<string, object>> Post(string url, object body)
        {
            int[] delays = { 1000, 2000, 4000, 8000 };
            for (int attempt = 0; ; attempt++)
            {
                var req = new HttpRequestMessage(HttpMethod.Post, url); req.Headers.Add("x-goog-api-key", ApiKey);
                req.Content = new StringContent(js.Serialize(body), Encoding.UTF8, "application/json");
                HttpResponseMessage resp = null; string raw = null;
                try { resp = await http.SendAsync(req); raw = await resp.Content.ReadAsStringAsync(); }
                catch (Exception ex) { if (attempt < delays.Length) { await Task.Delay(delays[attempt]); continue; } throw new Exception("שגיאת רשת: " + ex.Message); }
                if (resp.IsSuccessStatusCode) return (Dictionary<string, object>)js.DeserializeObject(raw);
                int code = (int)resp.StatusCode;
                if ((code == 429 || code == 500 || code == 502 || code == 503 || code == 504) && attempt < delays.Length) { Console.WriteLine("   ⏳ " + code); await Task.Delay(delays[attempt]); continue; }
                throw new Exception(raw);
            }
        }
        static async Task<List<float[]>> EmbedBatch(List<string> texts)
        {
            var outv = new List<float[]>();
            for (int i = 0; i < texts.Count; i += 50)
            {
                var slice = texts.Skip(i).Take(50).ToList(); var reqs = new List<object>();
                foreach (var t in slice) reqs.Add(new Dictionary<string, object> { { "model", "models/" + EmbedModel }, { "content", new Dictionary<string, object> { { "parts", new object[] { new Dictionary<string, object> { { "text", t } } } } } } });
                var root = await Post(ApiBase + EmbedModel + ":batchEmbedContents", new Dictionary<string, object> { { "requests", reqs } });
                foreach (var e in (object[])root["embeddings"]) { var vals = (object[])((Dictionary<string, object>)e)["values"]; var arr = new float[vals.Length]; for (int k = 0; k < vals.Length; k++) arr[k] = Convert.ToSingle(vals[k]); outv.Add(arr); }
            }
            return outv;
        }

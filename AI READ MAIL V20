        static async Task<Dictionary<string, object>> ReadJson(HttpListenerRequest request)
        { string b; using (var r = new StreamReader(request.InputStream, Encoding.UTF8)) b = await r.ReadToEndAsync(); return js.DeserializeObject(b) as Dictionary<string, object>; }
        static string Str(Dictionary<string, object> d, string k) { return (d != null && d.ContainsKey(k) && d[k] != null) ? d[k].ToString() : null; }

        static string RepairLooseJson(string s)
        {
            if (string.IsNullOrWhiteSpace(s)) return s;
            // מוסיף מרכאות לשמות שדות שלא במרכאות: {kind:  או  ,query:
            s = Regex.Replace(s, @"([\{,]\s*)([A-Za-z_][A-Za-z0-9_]*)\s*:", "$1\"$2\":");
            // מוסיף מרכאות לערכים מילוליים "חשופים" (לא true/false/null/מספר), לפני פסיק או סוגר
            s = Regex.Replace(s, @":\s*(?!"")(?!true\b)(?!false\b)(?!null\b)([A-Za-z_][A-Za-z0-9_.\-]*)\s*(?=[,}])", ": \"$1\"");
            return s;
        }

        static async Task<object> DetectIntent(string message)
        {
            if (string.IsNullOrWhiteSpace(message)) return new { kind = "none" };
            bool maybeFile = message.Contains("\\") || message.Contains(":") || message.Contains("העתק") || message.Contains("להעתיק") || message.Contains("העבר") || message.Contains("תעביר");
            bool maybeMail = message.Contains("מייל") || message.Contains("מיילים") || message.Contains("אאוטלוק") || message.Contains("outlook") || message.Contains("דוא") || message.Contains("הודעות") || message.Contains("שלח");
            bool maybeSql = message.Contains("JOB") || message.Contains("job") || message.Contains("Job") || message.Contains("SQL") || message.Contains("sql") || message.Contains("SSMS") || message.Contains("עבודה") || message.Contains("הרץ מחדש") || message.Contains("נכשל");
            if (!maybeFile && !maybeMail && !maybeSql) return new { kind = "none" };

            string kbContext = "";
            if (maybeFile)
            {
                var chunks = RetrieveRelevantChunks(message, TOP_K);
                var kb = new StringBuilder();
                foreach (var c in chunks) kb.Append("[" + c.Source + "]\n" + c.Text + "\n\n");
                kbContext = kb.ToString();

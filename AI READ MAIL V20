                if (action == "rtl")
                {
                    if (!File.Exists(path)) return new { ok = false, error = "הקובץ לא קיים." };
                    using (var wb = new XLWorkbook(path)) { foreach (var ws2 in wb.Worksheets) ws2.RightToLeft = true; wb.Save(); }
                    Console.WriteLine("📊 שונה כיוון ל-RTL: " + path);
                    return new { ok = true, action = "rtl", path = path };
                }

                if (action == "setCell")

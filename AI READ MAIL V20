    static void SetCheckBox(AutomationElement parentWindow, string automationId, bool check)
    {
        AutomationElement cb = parentWindow.FindFirst(TreeScope.Descendants,
            new PropertyCondition(AutomationElement.AutomationIdProperty, automationId));

        if (cb == null) { Console.WriteLine("   (!) לא נמצאה תיבת סימון: " + automationId); return; }

        object pattern;
        if (cb.TryGetCurrentPattern(TogglePattern.Pattern, out pattern))
        {
            TogglePattern toggle = (TogglePattern)pattern;
            bool isChecked = toggle.Current.ToggleState == ToggleState.On;
            if (isChecked != check)
            {
                try { toggle.Toggle(); }
                catch (Exception ex) { Console.WriteLine("   (!) סימון נכשל: " + ex.Message); }
            }
            else
            {
                Console.WriteLine("   (המצב כבר היה כמו שרצינו)");
            }
        }
        else
        {
            Console.WriteLine("   (!) התיבה לא תומכת בסימון ישיר.");
        }
    }


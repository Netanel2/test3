        static object ListFailedJobs(string dateFilter)
        {
            string cs = SqlConnStr();
            if (cs == null) return new { ok = false, error = "לא הוגדר SQL_SERVER בקובץ ה-.env." };
            DateTime day = dateFilter == "yesterday" ? DateTime.Today.AddDays(-1) : DateTime.Today;
            string dayStr = day.ToString("yyyyMMdd");
            var jobs = new List<object>();
            try
            {
                using (var conn = new SqlConnection(cs))
                {
                    conn.Open();
                    string sql = @"SELECT j.name AS JobName, h.run_date, h.run_time, h.message
                                   FROM msdb.dbo.sysjobs j
                                   JOIN msdb.dbo.sysjobhistory h ON j.job_id = h.job_id
                                   WHERE h.step_id = 0 AND h.run_status = 0 AND h.run_date = @d
                                   ORDER BY h.run_date DESC, h.run_time DESC";
                    using (var cmd = new SqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@d", dayStr);
                        using (var r = cmd.ExecuteReader())
                        {
                            while (r.Read())
                            {
                                string name = r["JobName"] as string ?? "";
                                int rd = r["run_date"] is int ? (int)r["run_date"] : 0;
                                int rt = r["run_time"] is int ? (int)r["run_time"] : 0;
                                string msg = r["message"] as string ?? "";
                                if (msg.Length > 300) msg = msg.Substring(0, 300) + "...";
                                string timeStr = rt.ToString("D6");
                                string dateFmt = rd.ToString().Length == 8 ? (rd.ToString().Substring(6, 2) + "/" + rd.ToString().Substring(4, 2) + "/" + rd.ToString().Substring(0, 4)) : rd.ToString();
                                jobs.Add(new { name = name, date = dateFmt, time = timeStr.Substring(0, 2) + ":" + timeStr.Substring(2, 2) + ":" + timeStr.Substring(4, 2), message = msg });
                            }
                        }
                    }
                }
                Console.WriteLine("🗄️ נמצאו " + jobs.Count + " JOBs שנכשלו.");
                return new { ok = true, jobs = jobs };
            }
            catch (Exception ex) { return new { ok = false, error = "שגיאת SQL: " + ex.Message }; }
        }

        static bool TryRunSqlJob(string jobName, out string error)
        {
            error = null;

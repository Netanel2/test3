}catch(e){d.querySelector('.bubble').textContent='שגיאה: '+e.message;}}

async function showFileConfirm(d,intent){
var b=d.querySelector('.bubble');
// קודם מריצים plan כדי לדעת כמה קבצים
var plan;
try{var r=await fetch('/api/fs/plan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(intent)});
plan=await r.json();}catch(e){b.textContent='שגיאה בבדיקת התוכנית: '+e.message;return;}
if(!plan.ok){b.textContent='⚠️ '+plan.error;return;}
var opText=plan.op==='move'?'להעביר (מוחק מהמקור)':'להעתיק';
var h='<div class=\'confirm\'>הבנתי שאתה רוצה <b>'+opText+' '+plan.count+'</b> קבצים ('+plan.size+'):<br>';
h+='מ: <code>'+plan.source+'</code><br>אל: <code>'+plan.dest+'</code>'+(plan.destExists?'':' (ייווצר)');
if(plan.sample&&plan.sample.length){h+='<div style=\'font-size:12px;color:#8b93a4;margin-top:6px\'>דוגמאות: '+plan.sample.join(', ')+(plan.count>20?' ...':'')+'</div>';}
h+='</div>';
b.innerHTML=h;
if(plan.count>0){var box=document.createElement('div');box.className='cbtns';
var go=document.createElement('button');go.className='go';go.textContent='▶ בצע';
var no=document.createElement('button');no.className='no';no.textContent='ביטול';
go.onclick=async function(){go.disabled=true;no.disabled=true;go.textContent='מבצע...';
try{var r=await fetch('/api/fs/execute',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(intent)});
var j=await r.json();
if(j.ok){box.innerHTML='<span style=\'color:#2ea043\'>✓ בוצע: '+j.done+' · דולגו: '+j.skipped+' · מתוך '+j.total+(j.errors&&j.errors.length?' · שגיאות: '+j.errors.length:'')+'</span>';}
else{box.innerHTML='<span style=\'color:#e06c6c\'>⚠️ '+j.error+'</span>';}
}catch(e){box.innerHTML='<span style=\'color:#e06c6c\'>שגיאה: '+e.message+'</span>';}};
no.onclick=function(){box.innerHTML='<span style=\'color:#8b93a4\'>בוטל.</span>';};
box.appendChild(go);box.appendChild(no);b.appendChild(box);}
else{b.innerHTML+='<div style=\'color:#8b93a4;margin-top:6px\'>לא נמצאו קבצים מתאימים.</div>';}}


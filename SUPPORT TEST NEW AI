        static async Task<object> DetectFileIntent(string message)
        {
            if (string.IsNullOrWhiteSpace(message)) return new { isFileOp = false };
            // אם אין רמז לנתיב (אין ':' או '\') — כנראה לא פעולת קבצים. חוסך קריאה.
            if (!message.Contains("\\") && !message.Contains(":")) return new { isFileOp = false };

            string prompt =
                "המשתמש כתב הודעה. קבע אם זו בקשה לפעולת קבצים (העברה/העתקה בין תיקיות).\n" +
                "החזר JSON בלבד, בלי טקסט נוסף ובלי סימני קוד:\n" +
                "{\"isFileOp\":true או false,\"op\":\"copy\" או \"move\",\"source\":\"נתיב מקור מלא\",\"dest\":\"נתיב יעד מלא\",\"pattern\":\"סינון או *\"}\n" +
                "op=move רק אם ביקש מפורשות 'העבר'/'תעביר'/'הזז'. אם 'העתק'/'תעתיק' או לא ברור — copy.\n" +
                "אם לא צוין סינון — pattern=\"*\". העתק את הנתיבים בדיוק כפי שהמשתמש כתב אותם, כולל רווחים.\n" +
                "אם זו לא בקשת פעולת קבצים — {\"isFileOp\":false}.\n\nההודעה: " + message;

            var body = new Dictionary<string, object> {
                { "contents", new object[] { new Dictionary<string, object> { { "role", "user" }, { "parts", new object[] { new Dictionary<string, object> { { "text", prompt } } } } } } } };
            string raw = ReadText(await Post(ApiBase + ChatModel + ":generateContent", body));
            raw = raw.Replace("```json", "").Replace("```", "").Trim();
            try
            {
                var d = js.DeserializeObject(raw) as Dictionary<string, object>;
                if (d == null || !d.ContainsKey("isFileOp")) return new { isFileOp = false };
                bool isOp = d["isFileOp"] is bool && (bool)d["isFileOp"];
                if (!isOp) return new { isFileOp = false };
                string op = Str(d, "op"); if (op != "move") op = "copy";
                string src = Str(d, "source"); string dst = Str(d, "dest"); string pat = Str(d, "pattern");
                if (string.IsNullOrWhiteSpace(pat)) pat = "*";
                if (string.IsNullOrWhiteSpace(src) || string.IsNullOrWhiteSpace(dst)) return new { isFileOp = false };
                return new { isFileOp = true, op = op, source = src, dest = dst, pattern = pat };
            }
            catch { return new { isFileOp = false }; }
        }


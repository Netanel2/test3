        static string Friendly(string raw)
        {
            if (string.IsNullOrEmpty(raw)) return "אירעה שגיאה. נסה שוב.";
            if (raw.Contains("503") || raw.Contains("UNAVAILABLE") || raw.Contains("high demand")) return "המודל עמוס כרגע. נסה שוב בעוד רגע.";
            if (raw.Contains("429") || raw.Contains("quota") || raw.Contains("RESOURCE_EXHAUSTED")) return "הגעת למכסת הבקשות. חכה דקה.";
            if (raw.Contains("401") || raw.Contains("403") || raw.Contains("API_KEY") || raw.Contains("PERMISSION")) return "בעיה במפתח ה-API. ודא GEMINI_API_KEY ב-.env.";
            if (raw.Contains("404") || raw.Contains("NOT_FOUND")) return "המודל לא זמין. בדוק CHAT_MODEL ב-.env.";
            return "שגיאה: " + (raw.Length > 200 ? raw.Substring(0, 200) : raw);
        }


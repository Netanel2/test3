async function send(){var t=q.value.trim();if(!t)return;q.value='';
if(learnMode){add('לימוד',t,'me');var dl=add('מערכת','שומר ומאנדקס...','learn');
try{var r=await fetch('/api/learn',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:t})});

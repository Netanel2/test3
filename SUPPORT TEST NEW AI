add('אתה',t,'me');var d=add('עוזר','חושב...');
// קודם בודקים אם זו בקשת פעולת קבצים
try{var ir=await fetch('/api/fs/intent',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})});
var ij=await ir.json();
if(ij&&ij.isFileOp){showFileConfirm(d,ij);return;}
}catch(e){}
// אחרת — שאלה רגילה
try{var r=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question:t})});
var j=await r.json();
if(j.answer){render(d.querySelector('.bubble'),j.answer);}else{d.querySelector('.bubble').textContent=j.error||'אין תשובה';}

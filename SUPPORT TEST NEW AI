function b64(file){return new Promise(function(res,rej){var r=new FileReader();
r.onload=function(){res(r.result.split(',')[1]);};r.onerror=function(){rej(new Error('קריאה נכשלה'));};r.readAsDataURL(file);});}
async function handle(files){for(var i=0;i<files.length;i++){var f=files[i];

        static bool IsAllowed(string path)
        {
            if (AllowedDirs == null || AllowedDirs.Length == 0) return true;
            string full; try { full = Path.GetFullPath(path).TrimEnd('\\') + "\\"; } catch { return false; }
            foreach (var d in AllowedDirs)
            { string bd; try { bd = Path.GetFullPath(d).TrimEnd('\\') + "\\"; } catch { continue; }
                if (full.StartsWith(bd, StringComparison.OrdinalIgnoreCase)) return true; }
            return false;
        }
        static string Human(long b) { string[] u = { "B", "KB", "MB", "GB", "TB" }; double s = b; int i = 0; while (s >= 1024 && i < u.Length - 1) { s /= 1024; i++; } return s.ToString("0.##") + " " + u[i]; }

        static object FsAnalyze(string path, bool recursive)
        {
            if (string.IsNullOrWhiteSpace(path)) return new { ok = false, error = "נתיב ריק" };
            if (!IsAllowed(path)) return new { ok = false, error = "הנתיב מחוץ לתיקיות המותרות (ALLOWED_DIRS)." };
            if (!Directory.Exists(path)) return new { ok = false, error = "התיקייה לא קיימת: " + path };
            var files = Directory.GetFiles(path, "*", recursive ? SearchOption.AllDirectories : SearchOption.TopDirectoryOnly);
            long total = 0; var byExt = new Dictionary<string, long[]>();
            foreach (var f in files) { long len = 0; try { len = new FileInfo(f).Length; } catch { } total += len;
                string ext = Path.GetExtension(f).ToLowerInvariant(); if (ext == "") ext = "(ללא סיומת)";
                if (!byExt.ContainsKey(ext)) byExt[ext] = new long[2]; byExt[ext][0]++; byExt[ext][1] += len; }
            var types = byExt.OrderByDescending(k => k.Value[1]).Select(k => new { ext = k.Key, count = k.Value[0], size = Human(k.Value[1]) }).ToList();
            return new { ok = true, total = files.Length, totalSize = Human(total), types = types };
        }

        static object FsPlan(string source, string dest, string pattern, string op)
        {
            if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(dest)) return new { ok = false, error = "חסר מקור או יעד" };
            if (!IsAllowed(source)) return new { ok = false, error = "נתיב המקור מחוץ לתיקיות המותרות." };
            if (!IsAllowed(dest)) return new { ok = false, error = "נתיב היעד מחוץ לתיקיות המותרות." };
            if (!Directory.Exists(source)) return new { ok = false, error = "תיקיית המקור לא קיימת: " + source };
            if (string.IsNullOrWhiteSpace(pattern)) pattern = "*";
            var files = Directory.GetFiles(source, pattern, SearchOption.TopDirectoryOnly);
            long size = 0; var names = new List<string>();
            foreach (var f in files) { try { size += new FileInfo(f).Length; } catch { } names.Add(Path.GetFileName(f)); }
            return new { ok = true, op = (op == "move" ? "move" : "copy"), count = files.Length, size = Human(size), source = source, dest = dest, destExists = Directory.Exists(dest), sample = names.Take(20).ToList() };
        }

        static object FsExecute(string source, string dest, string pattern, string op)
        {
            if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(dest)) return new { ok = false, error = "חסר מקור או יעד" };
            if (!IsAllowed(source)) return new { ok = false, error = "נתיב המקור מחוץ לתיקיות המותרות." };
            if (!IsAllowed(dest)) return new { ok = false, error = "נתיב היעד מחוץ לתיקיות המותרות." };
            if (!Directory.Exists(source)) return new { ok = false, error = "תיקיית המקור לא קיימת." };
            if (string.IsNullOrWhiteSpace(pattern)) pattern = "*";
            Directory.CreateDirectory(dest);
            bool move = op == "move";
            var files = Directory.GetFiles(source, pattern, SearchOption.TopDirectoryOnly);
            int done = 0, skipped = 0; var errors = new List<string>();
            foreach (var f in files)
            {
                string target = Path.Combine(dest, Path.GetFileName(f));
                try { if (File.Exists(target)) { skipped++; continue; } if (move) File.Move(f, target); else File.Copy(f, target); done++; }
                catch (Exception e) { errors.Add(Path.GetFileName(f) + ": " + e.Message); }
            }
            Console.WriteLine("🗂️ " + (move ? "הועברו " : "הועתקו ") + done + " קבצים.");
            return new { ok = true, op = (move ? "move" : "copy"), done = done, skipped = skipped, errors = errors, total = files.Length };
        }


try{var data=await b64(f);
var r=await fetch('/api/upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filename:f.name,data:data})});
var j=await r.json();if(j.ok){d.querySelector('.bubble').textContent='נוסף למאגר: '+f.name+' ('+j.added+' קטעים) ✓';stats();}
else{d.querySelector('.bubble').textContent='שגיאה ב-'+f.name+': '+(j.error||'נכשל');}
}catch(e){d.querySelector('.bubble').textContent='שגיאה: '+e.message;}}}


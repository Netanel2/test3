    class Section { public string Source { get; set; } public string Text { get; set; } }
    public class Chunk { public string Source { get; set; } public string Text { get; set; } public float[] Embedding { get; set; } }

    class Program
    {
        static string BaseDir = AppDomain.CurrentDomain.BaseDirectory;
        static string GuidesDir = Path.Combine(BaseDir, "guides");
        static string DataDir = Path.Combine(BaseDir, "data");
        static string IndexPath = Path.Combine(DataDir, "index.json");

        static string ApiKey;
        static string ChatModel = "gemini-2.5-flash";
        static string EmbedModel = "gemini-embedding-001";
        const string ApiBase = "https://googleapis.com";

        static readonly HttpClient http = new HttpClient();
        static readonly JavaScriptSerializer js = new JavaScriptSerializer { MaxJsonLength = int.MaxValue };

        const string SysPrompt =
            "אתה עוזר פנימי שעונה על שאלות לפי מדריכי הפעלה. ענה בעברית בלבד, מעשית ושלב-אחר-שלב. " +
            "השתמש אך ורק במידע שבקטעים שסופקו. אל תמציא. אם התשובה לא נמצאת — אמור זאת. ציין בסוף מאיזה מדריך.";
        const string VisionPrompt =
            "מולך צילום מסך ממדריך. תאר בעברית: תמלל את כל הטקסט, תאר מיקום כפתורים/תפריטים, " +
            "והסבר איזו פעולה מוצגת (על מה לוחצים). אל תמציא. עברית בלבד.";
        static void Main(string[] args)
        {
            try { Console.OutputEncoding = Encoding.UTF8; } catch { }
            ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;
            http.Timeout = TimeSpan.FromMinutes(3);

            LoadDotEnv();
            ApiKey = Environment.GetEnvironmentVariable("GEMINI_API_KEY");
            var em = Environment.GetEnvironmentVariable("EMBED_MODEL"); if (!string.IsNullOrWhiteSpace(em)) EmbedModel = em;
            var cm = Environment.GetEnvironmentVariable("CHAT_MODEL"); if (!string.IsNullOrWhiteSpace(cm)) ChatModel = cm;

            Directory.CreateDirectory(GuidesDir);
            Directory.CreateDirectory(DataDir);

            List<Chunk> index = new List<Chunk>();
            if (File.Exists(IndexPath))
            {
                try { index = js.Deserialize<List<Chunk>>(File.ReadAllText(IndexPath, Encoding.UTF8)) ?? new List<Chunk>(); }
                catch { index = Ingest().GetAwaiter().GetResult(); }
            }
            else { index = Ingest().GetAwaiter().GetResult(); }

            HttpListener listener = new HttpListener();
            try
            {
                listener.Prefixes.Add("http://localhost:5000/");
                listener.Start();
                Console.WriteLine("🌐 השרת עלה בהצלחה! פתח את הדפדפן בכתובת: http://localhost:5000/");
            }
            catch (Exception ex)
            {
                Console.WriteLine("❌ כשל בהפעלת השרת: " + ex.Message);
                Console.ReadLine();
                return;
            }

            Task.Run(async () =>
            {
                while (listener.IsListening)
                {
                    try
                    {
                        HttpListenerContext context = await listener.GetContextAsync();
                        HttpListenerRequest request = context.Request;
                        HttpListenerResponse response = context.Response;

                        response.Headers.Add("Access-Control-Allow-Origin", "*");
                        response.Headers.Add("Access-Control-Allow-Headers", "Content-Type");

                        if (request.HttpMethod == "OPTIONS")
                        {
                            response.StatusCode = 200;
                            response.Close();
                            continue;
                        }

                        if (request.Url.AbsolutePath == "/api/chat" && request.HttpMethod == "POST")
                        {
                            string bodyText;
                            using (StreamReader reader = new StreamReader(request.InputStream, request.ContentEncoding))
                            {
                                bodyText = await reader.ReadToEndAsync();
                            }

                            var requestData = (Dictionary<string, object>)js.DeserializeObject(bodyText);
                            string q = requestData != null && requestData.ContainsKey("question") ? requestData["question"].ToString().Trim() : "";

                            Console.WriteLine("📩 התקבלה שאלה מהאתר: " + q);

                            if (string.IsNullOrEmpty(q))
                            {
                                response.StatusCode = 400;
                                byte[] errBuffer = Encoding.UTF8.GetBytes(js.Serialize(new { error = "שאלה ריקה" }));
                                response.ContentType = "application/json; charset=utf-8";
                                await response.OutputStream.WriteAsync(errBuffer, 0, errBuffer.Length);
                                response.Close();
                                continue;
                            }

                            Console.WriteLine("🔍 מחשב Embeddings לשאלת המשתמש...");
                            var qvList = await EmbedBatch(new List<string> { q });
                            var qv = qvList[0]; // שליפת הוקטור הבודד בצורה מתוקנת

                            Console.WriteLine("📊 מחשב מרחק ווקטורי (Cosine)...");
                            var top = index.Select(c => new { c, s = Cosine(qv, c.Embedding) })
                                           .OrderByDescending(x => x.s).Take(6).Select(x => x.c).ToList();

                            StringBuilder sb = new StringBuilder(); int i = 1; List<string> srcs = new List<string>();
                            foreach (var c in top)
                            {
                                if (!srcs.Contains(c.Source)) srcs.Add(c.Source);
                                sb.Append("[מקור " + i + " — " + c.Source + "]\n" + c.Text + "\n\n---\n\n"); i++;
                            }

                            Console.WriteLine("🤖 שולח את השאלה והמדריכים הרלוונטיים ל-Gemini API...");
                            string ans = await Chat("קטעים מהמדריכים:\n\n" + sb + "=====\nשאלה: " + q);

                            Console.WriteLine("✅ התקבלה תשובה מג'מיני!");

                            response.ContentType = "application/json; charset=utf-8";
                            byte[] buffer = Encoding.UTF8.GetBytes(js.Serialize(new { answer = ans, sources = srcs }));
                            await response.OutputStream.WriteAsync(buffer, 0, buffer.Length);
                            response.Close();
                        }
                        else
                        {
                            string wwwroot = Path.Combine(BaseDir, "wwwroot");
                            string filePath = Path.Combine(wwwroot, "index.html");

                            if (File.Exists(filePath))
                            {
                                response.ContentType = "text/html; charset=utf-8";
                                byte[] htmlBuffer = File.ReadAllBytes(filePath);
                                await response.OutputStream.WriteAsync(htmlBuffer, 0, htmlBuffer.Length);
                            }
                            else
                            {
                                response.StatusCode = 404;
                                byte[] fontBuffer = Encoding.UTF8.GetBytes("קובץ index.html לא נמצא בתיקיית wwwroot");
                                await response.OutputStream.WriteAsync(fontBuffer, 0, fontBuffer.Length);
                            }
                            response.Close();
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine("⚠️ שגיאה בטיפול בבקשה: " + ex.Message);
                    }
                }
            });

            Console.ReadLine();
        }
        // ===== אינדוקס =====
        static async Task<List<Chunk>> Ingest()
        {
            var exts = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".txt", ".md", ".docx", ".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif" };
            var files = Directory.Exists(GuidesDir) ? Directory.GetFiles(GuidesDir, "*.*", SearchOption.AllDirectories).Where(f => exts.Contains(Path.GetExtension(f))).OrderBy(f => f).ToList() : new List<string>();
            if (files.Count == 0) return new List<Chunk>();

            var sections = new List<Section>();
            foreach (var f in files)
            {
                try { sections.AddRange(await Extract(f)); } catch { }
            }

            var chunks = Chunkify(sections);
            if (chunks.Count == 0) return new List<Chunk>();

            var vecs = await EmbedBatch(chunks.Select(c => c.Text).ToList());
            for (int i = 0; i < chunks.Count; i++) chunks[i].Embedding = vecs[i];

            File.WriteAllText(IndexPath, js.Serialize(chunks), new UTF8Encoding(false));
            return chunks;
        }

        static async Task<List<Section>> Extract(string path)
        {
            string ext = Path.GetExtension(path).ToLowerInvariant();
            string name = Path.GetFileName(path);
            var res = new List<Section>();

            if (ext == ".txt" || ext == ".md")
                res.Add(new Section { Source = name, Text = File.ReadAllText(path, Encoding.UTF8) });
            else if (ext == ".docx")
                res.AddRange(await FromDocx(path, name));
            else
            {
                byte[] bytes = File.ReadAllBytes(path);
                string desc = await DescribeImage(bytes, MimeFor(ext), VisionPrompt + "\nהקשר: " + name);
                res.Add(new Section { Source = name, Text = desc });
            }
            return res;
        }

        static async Task<List<Section>> FromDocx(string path, string name)
        {
            var res = new List<Section>();
            using (var zip = ZipFile.OpenRead(path))
            {
                var doc = zip.GetEntry("word/document.xml");
                if (doc != null)
                {
                    using (var s = doc.Open())
                    {
                        var sb = new StringBuilder();
                        using (var r = XmlReader.Create(s, new XmlReaderSettings { IgnoreWhitespace = false }))
                            while (r.Read())
                                if (r.NodeType == XmlNodeType.Element)
                                {
                                    if (r.LocalName == "t") sb.Append(r.ReadElementContentAsString());
                                    else if (r.LocalName == "p" || r.LocalName == "br") sb.Append('\n');
                                }
                        if (sb.ToString().Trim().Length > 0)
                            res.Add(new Section { Source = name, Text = sb.ToString().Trim() });
                    }
                }
            }
            return res;
        }

        static List<Chunk> Chunkify(List<Section> secs)
        {
            var outp = new List<Chunk>();
            foreach (var s in secs)
            {
                string t = (s.Text ?? "").Trim(); if (t.Length == 0) continue;
                int start = 0;
                while (start < t.Length)
                {
                    int len = Math.Min(1500, t.Length - start);
                    outp.Add(new Chunk { Source = s.Source, Text = t.Substring(start, len).Trim() });
                    start += 1250;
                }
            }
            return outp;
        }

        static async Task<Dictionary<string, object>> Post(string url, object body)
        {
            var req = new HttpRequestMessage(HttpMethod.Post, url);
            req.Headers.Add("x-goog-api-key", ApiKey);
            req.Content = new StringContent(js.Serialize(body), Encoding.UTF8, "application/json");
            var resp = await http.SendAsync(req);
            string raw = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode) throw new Exception(raw);
            return (Dictionary<string, object>)js.DeserializeObject(raw);
        }
        public static async Task<List<float[]>> EmbedBatch(List<string> texts)
        {
            var outv = new List<float[]>();
            for (int i = 0; i < texts.Count; i += 50)
            {
                var slice = texts.Skip(i).Take(50).ToList();
                var reqs = new List<object>();
                foreach (var t in slice)
                    reqs.Add(new Dictionary<string, object> {
                        {"model","models/"+EmbedModel},
                        {"content", new Dictionary<string,object>{ {"parts", new object[]{ new Dictionary<string,object>{ {"text",t} } } } }}
                    });
                var root = await Post(ApiBase + EmbedModel + ":batchEmbedContents", new Dictionary<string, object> { { "requests", reqs } });
                var embs = (object[])root["embeddings"];
                foreach (var e in embs)
                {
                    var vals = (object[])((Dictionary<string, object>)e)["values"];
                    var arr = new float[vals.Length];
                    for (int k = 0; k < vals.Length; k++) arr[k] = Convert.ToSingle(vals[k]);
                    outv.Add(arr);
                }
            }
            return outv;
        }

        static async Task<string> Chat(string userPrompt)
        {
            var body = new Dictionary<string, object> {
                {"systemInstruction", new Dictionary<string,object>{ {"parts", new object[]{ new Dictionary<string,object>{ {"text", SysPrompt} } } } }},
                {"contents", new object[]{ new Dictionary<string,object>{ {"role","user"}, {"parts", new object[]{ new Dictionary<string,object>{ {"text", userPrompt} } } } } }},
                {"generationConfig", new Dictionary<string,object>{ {"temperature",0.2}, {"maxOutputTokens",4096} }}
            };
            return ReadText(await Post(ApiBase + ChatModel + ":generateContent", body));
        }

        static async Task<string> DescribeImage(byte[] bytes, string mime, string prompt)
        {
            string b64 = Convert.ToBase64String(bytes);
            var body = new Dictionary<string, object> {
                {"contents", new object[]{ new Dictionary<string,object>{ {"role","user"}, {"parts", new object[]{
                    new Dictionary<string, object>{ {"text", prompt} },
                    new Dictionary<string, object>{ {"inlineData", new Dictionary<string,object>{ {"mimeType",mime}, {"data",b64} } } }
                } } } }},
                {"generationConfig", new Dictionary<string,object>{ {"temperature",0.1}, {"maxOutputTokens",1500} }}
            };
            try { return ReadText(await Post(ApiBase + ChatModel + ":generateContent", body)); } catch (Exception e) { return "[שגיאה: " + e.Message + "]"; }
        }

        static string ReadText(Dictionary<string, object> root)
        {
            try
            {
                if (root == null || !root.ContainsKey("candidates")) return "[אין תשובה]";
                var cands = root["candidates"] as System.Collections.IEnumerable;
                if (cands == null) return "[אין תשובה]";
                Dictionary<string, object> c0 = null;
                foreach (var item in cands) { c0 = item as Dictionary<string, object>; break; }
                if (c0 == null || !c0.ContainsKey("content")) return "[אין טקסט]";
                var content = c0["content"] as Dictionary<string, object>;
                var parts = content["parts"] as System.Collections.IEnumerable;
                StringBuilder sb = new StringBuilder();
                foreach (var p in parts)
                {
                    var pd = p as Dictionary<string, object>;
                    if (pd != null && pd.ContainsKey("text")) sb.Append(pd["text"] as string);
                }
                return sb.ToString().Trim();
            }
            catch { return "[שגיאה בפענוח]"; }
        }

        static double Cosine(float[] a, float[] b)
        {
            if (a == null || b == null || a.Length != b.Length) return 0;
            double dot = 0, na = 0, nb = 0;
            for (int i = 0; i < a.Length; i++) { dot += a[i] * b[i]; na += a[i] * a[i]; nb += b[i] * b[i]; }
            return (na == 0 || nb == 0) ? 0 : dot / (Math.Sqrt(na) * Math.Sqrt(nb));
        }

        static string MimeFor(string ext)
        {
            ext = ext.ToLowerInvariant();
            if (ext == ".png") return "image/png";
            if (ext == ".gif") return "image/gif";
            if (ext == ".webp") return "image/webp";
            if (ext == ".bmp") return "image/bmp";
            return "image/jpeg";
        }

        static void LoadDotEnv()
        {
            string dir = BaseDir;
            for (int up = 0; up < 4; up++)
            {
                string p = Path.Combine(dir, ".env");
                if (File.Exists(p))
                {
                    foreach (var line in File.ReadAllLines(p))
                    {
                        string t = line.Trim();
                        if (t.Length == 0 || t.StartsWith("#")) continue;
                        int eq = t.IndexOf('=');
                        if (eq <= 0) continue;
                        string k = t.Substring(0, eq).Trim(), v = t.Substring(eq + 1).Trim();
                        if (Environment.GetEnvironmentVariable(k) == null) Environment.SetEnvironmentVariable(k, v);
                    }
                    return;
                }
                var parent = Directory.GetParent(dir); if (parent == null) break; dir = parent.FullName;
            }
        }
    }
